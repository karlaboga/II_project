<Window x:Class="Inventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory - Bengos Restaurant" Height="550" Width="850"
        Background="#FAF0E6">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Product Name" VerticalAlignment="Center" Margin="5"
                   Foreground="#5C3A21" FontWeight="SemiBold"/>
        <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="0" Grid.Column="1" Margin="5"
                 BorderBrush="#E8D5B7" Background="#FFF8F0" Foreground="#5C3A21"/>
        <TextBlock Grid.Row="1" Text="Category" VerticalAlignment="Center" Margin="5"
                   Foreground="#5C3A21" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="5"
                  Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                  BorderBrush="#E8D5B7" Background="#FFF8F0" Foreground="#5C3A21">
            <ComboBoxItem Content="Fruits"/>
            <ComboBoxItem Content="Vegetables"/>
            <ComboBoxItem Content="Meat"/>
            <ComboBoxItem Content="Dairy"/>
            <ComboBoxItem Content="Spices"/>
        </ComboBox>
        <TextBlock Grid.Row="2" Text="Quantity" VerticalAlignment="Center" Margin="5"
                   Foreground="#5C3A21" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="2" Grid.Column="1" Margin="5"
                 BorderBrush="#E8D5B7" Background="#FFF8F0" Foreground="#5C3A21"/>
        <TextBlock Grid.Row="3" Text="Unit" VerticalAlignment="Center" Margin="5"
                   Foreground="#5C3A21" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="5"
                  Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                  BorderBrush="#E8D5B7" Background="#FFF8F0" Foreground="#5C3A21">
            <ComboBoxItem Content="Kilograms"/>
            <ComboBoxItem Content="Liters"/>
            <ComboBoxItem Content="Pieces"/>
            <ComboBoxItem Content="Boxes"/>
        </ComboBox>
        <TextBlock Grid.Row="4" Text="Min Stock" VerticalAlignment="Center" Margin="5"
                   Foreground="#5C3A21" FontWeight="SemiBold"/>
        <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="4" Grid.Column="1" Margin="5"
                 BorderBrush="#E8D5B7" Background="#FFF8F0" Foreground="#5C3A21"/>
        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="5" VerticalAlignment="Center" Margin="20,0,0,0">
            <Button Content="Add" Margin="5" Padding="12,8"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Command="{Binding AddCommand}"/>
            <Button Content="Edit" Margin="5" Padding="12,8"
                    Background="#8B5E3C" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Command="{Binding EditCommand}"/>
            <Button Content="Delete" Margin="5" Padding="12,8"
                    Background="#C94A4A" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Command="{Binding DeleteCommand}"/>
            <Button Content="Clear Filter" Margin="5" Padding="8,6"
                    Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                    FontWeight="SemiBold" Command="{Binding ClearFilterCommand}"/>
        </StackPanel>
        <DataGrid Grid.Row="6" Grid.ColumnSpan="3" Margin="5"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FFF8F0" BorderBrush="#E8D5B7"
                  Foreground="#5C3A21" RowBackground="#FFF8F0"
                  AlternatingRowBackground="#FAF0E6"
                  HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#D4A574"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="*"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*"/>
                <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>