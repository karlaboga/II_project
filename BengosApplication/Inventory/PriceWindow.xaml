<Window x:Class="Inventory.PriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Prices"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="💲 Manage Dish Prices" FontSize="20" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,5,0,15"/>
        <DataGrid Grid.Row="1" x:Name="DgPrices" AutoGenerateColumns="False"
                  Background="#FFF8F0" BorderBrush="#E8D5B7"
                  Foreground="#5C3A21" RowBackground="#FFF8F0"
                  AlternatingRowBackground="#FAF0E6"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CellEditEnding="DgPrices_CellEditEnding">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Dish" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Price" Binding="{Binding PriceDisplay}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Save Changes" Width="120" Height="34"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Margin="5"
                    Click="BtnSave_Click"/>
            <Button Content="Close" Width="100" Height="34"
                    Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                    FontWeight="Bold" Cursor="Hand" Margin="5"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>