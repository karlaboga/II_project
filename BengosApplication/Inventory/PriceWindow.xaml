<Window x:Class="Inventory.PriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Prices"
        Height="650" Width="1000"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
WindowStyle="None"
AllowsTransparency="True"
Background="#F3EDEE"
FontFamily="Segoe UI"
TextOptions.TextFormattingMode="Display"
TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="💲 Manage Dish Prices"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#4B2F3A"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,15"/>

        <DataGrid Grid.Row="1"
                  x:Name="DgPrices"
                  AutoGenerateColumns="False"
                  Background="#F3EDEE"
                  BorderBrush="#C9A3B5"
                  Foreground="#4B2F3A"
                  RowBackground="#F3EDEE"
                  AlternatingRowBackground="#E9DDE5"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CellEditEnding="DgPrices_CellEditEnding">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5E3E4A"/>
                    <Setter Property="Foreground" Value="#F3EDEE"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="32"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Dish" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Price" Binding="{Binding PriceDisplay}" Width="100"/>
            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="Save Changes"
                    Width="140"
                    Height="36"
                    Background="#5E3E4A"
                    Foreground="#F3EDEE"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Margin="5"/>

            <Button Content="Close"
                    Width="110"
                    Height="36"
                    Background="#C9A3B5"
                    Foreground="#4B2F3A"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Margin="5"/>

        </StackPanel>

    </Grid>
</Window>