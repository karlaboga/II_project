<Window x:Class="Inventory.LowStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Low Stock Alert"
        Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3EDEE">

    <Border Background="#F3EDEE" Padding="22">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Grid.Row="0"
                       Text="⚠ LOW STOCK ALERT"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#8A3F4A"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,18"/>

            <!-- DATA GRID -->
            <Border Grid.Row="1"
                    Background="#F3EDEE"
                    BorderBrush="#C9A3B5"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10">

                <DataGrid x:Name="DgLowStock"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#F3EDEE"
                          BorderThickness="0"
                          Foreground="#4B2F3A"
                          RowBackground="#F3EDEE"
                          AlternatingRowBackground="#E9DDE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Resources>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#5E3E4A"/>
                            <Setter Property="Foreground" Value="#F3EDEE"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#C9A3B5"/>
                                    <Setter Property="Foreground" Value="#F3EDEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- CLOSE BUTTON (FIXED CLICK) -->
            <Button Grid.Row="2"
                    Content="Close"
                    Width="140"
                    Height="38"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#F3EDEE"
                    Background="#5E3E4A"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnClose_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#7A5A68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>
    </Border>
</Window>