<Window x:Class="Inventory.LowStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Low Stock Alert"
        Height="650" Width="1000"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent" 
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      CornerRadius="24" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#F2F1F0" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Border Background="#8A3F4A"
                        CornerRadius="12"
                        Padding="15"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.1" Color="#8A3F4A"/>
                    </Border.Effect>
                    <TextBlock Text="⚠ LOW STOCK ALERT SYSTEM"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#F2F1F0"
                               HorizontalAlignment="Center"/>
                </Border>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,15,0" Width="32" Height="32"
                        Background="Transparent" Foreground="#F2F1F0"
                        FontWeight="Bold" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#A05563"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#E5DFD9"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.02" Color="#4A2D1C"/>
                </Border.Effect>

                <DataGrid x:Name="DgLowStock"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#4A2D1C"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F2F1F0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5DFD9"
                          RowHeight="42">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#4A2D1C"/>
                            <Setter Property="Foreground" Value="#F2F1F0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#8B7365"/>
                                    <Setter Property="Foreground" Value="#F2F1F0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style x:Key="PremiumTextBoxStyle" TargetType="TextBox">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="#F2F1F0"/>
                            <Setter Property="Foreground" Value="#4A2D1C"/>
                            <Setter Property="BorderBrush" Value="#E5DFD9"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Width" Value="90"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#8B7365"/>
                                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#4A2D1C"/>
                                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>

                        <DataGridTemplateColumn Header="Quantity to Add" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding AddQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource PremiumTextBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Action" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="➕ Restock" 
                                            Click="BtnRestock_Click"
                                            Background="#4A2D1C" 
                                            Foreground="#F2F1F0" 
                                            FontWeight="SemiBold" 
                                            FontSize="12" 
                                            Height="28" 
                                            Width="85"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#5F3B26"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Border>

        </Grid>
    </Border>
</Window>