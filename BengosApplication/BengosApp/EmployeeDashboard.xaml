<Window x:Class="BengosApp.EmployeeDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Dashboard"
        Height="480" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="TxtWelcome" FontSize="20" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,10,0,20"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Staff Card -->
            <Border Grid.Column="0" Margin="8" Background="#FFF8F0"
                    BorderBrush="#E8D5B7" BorderThickness="1" CornerRadius="12"
                    Padding="15" Cursor="Hand" MouseLeftButtonUp="BtnStaff_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="Staff" FontSize="16" FontWeight="Bold"
                               Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,8,0,3"/>
                    <TextBlock Text="Add Shifts" FontSize="10"
                               Foreground="#8B5E3C" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Menu Card -->
            <Border Grid.Column="1" Margin="8" Background="#FFF8F0"
                    BorderBrush="#E8D5B7" BorderThickness="1" CornerRadius="12"
                    Padding="15" Cursor="Hand" MouseLeftButtonUp="BtnMenu_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🍽️" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="Menu" FontSize="16" FontWeight="Bold"
                               Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,8,0,3"/>
                    <TextBlock Text="View + Warnings" FontSize="10"
                               Foreground="#8B5E3C" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Tables Card -->
            <Border Grid.Row="1" Grid.Column="0" Margin="8" Background="#FFF8F0"
                    BorderBrush="#E8D5B7" BorderThickness="1" CornerRadius="12"
                    Padding="15" Cursor="Hand" MouseLeftButtonUp="BtnTables_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🪑" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tables" FontSize="16" FontWeight="Bold"
                               Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,8,0,3"/>
                    <TextBlock Text="Manage Orders" FontSize="10"
                               Foreground="#8B5E3C" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Payment Card -->
            <Border Grid.Row="1" Grid.Column="1" Margin="8" Background="#FFF8F0"
                    BorderBrush="#E8D5B7" BorderThickness="1" CornerRadius="12"
                    Padding="15" Cursor="Hand" MouseLeftButtonUp="BtnPayment_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💳" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="Payment" FontSize="16" FontWeight="Bold"
                               Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,8,0,3"/>
                    <TextBlock Text="Process Payment" FontSize="10"
                               Foreground="#8B5E3C" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <Button Grid.Row="2" Content="Logout" Width="100" Height="34"
                Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                FontWeight="Bold" Cursor="Hand" Margin="0,15,0,5"
                HorizontalAlignment="Center" Click="BtnLogout_Click"/>
    </Grid>
</Window>