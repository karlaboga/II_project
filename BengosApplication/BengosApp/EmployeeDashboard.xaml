<Window x:Class="BengosApp.EmployeeDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Dashboard"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F3EDEE"
        FontFamily="Segoe UI">

    <!-- MAIN CARD -->
    <Border Background="#F3EDEE"
            CornerRadius="20"
            Margin="10">

       

        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#5E3E4A"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,25">

                <TextBlock Text="EMPLOYEE DASHBOARD"
           FontSize="22"
           FontWeight="SemiBold"
           Foreground="#F3EDEE"
           HorizontalAlignment="Center"/>
            </Border>

            <!-- DASHBOARD GRID -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TABLES -->
                <Border Grid.Column="0"
                        Margin="8"
                        Background="#F3EDEE"
                        BorderBrush="#C9A3B5"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="15"
                        Cursor="Hand"
                        MouseLeftButtonUp="BtnTables_Click">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="🪑"
                                   FontSize="32"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Tables"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#4B2F3A"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>

                        <TextBlock Text="Manage Orders"
                                   FontSize="10"
                                   Foreground="#7A5A68"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- PAYMENT -->
                <Border Grid.Column="1"
                        Margin="8"
                        Background="#F3EDEE"
                        BorderBrush="#C9A3B5"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="15"
                        Cursor="Hand"
                        MouseLeftButtonUp="BtnPayment_Click">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="💳"
                                   FontSize="32"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Payment"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#4B2F3A"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>

                        <TextBlock Text="Process Payment"
                                   FontSize="10"
                                   Foreground="#7A5A68"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- LOGOUT -->
            <Button Grid.Row="2"
                    Content="Logout"
                    Width="140"
                    Height="38"
                    Margin="0,25,0,0"
                    Background="#5E3E4A"
                    Foreground="#F3EDEE"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Click="BtnLogout_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7A5A68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>
    </Border>
</Window>