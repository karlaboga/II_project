<Window x:Class="BengosApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bengos Restaurant"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent" 
        WindowStyle="None"
        AllowsTransparency="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Georgia">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- BACKGROUND — contrast bun -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2F1F0" Offset="0.0"/>
                <GradientStop Color="#E5DFD9" Offset="0.3"/>
                <GradientStop Color="#D6C8BA" Offset="0.6"/>
                <GradientStop Color="#BFA58F" Offset="0.85"/>
                <GradientStop Color="#8C7A6A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- B (bulă) + RESTAURANT -->
        <Grid Grid.Column="0" VerticalAlignment="Stretch">

            <Viewbox Stretch="UniformToFill"
                     VerticalAlignment="Bottom"
                     HorizontalAlignment="Stretch"
                     Margin="-470,-400,-430,-260">
                <Border Width="600" Height="600" CornerRadius="300"
                        Background="#B3957D"
                        BorderBrush="#8C7A6A" BorderThickness="5">
                    <Grid>
                        <TextBlock Text="B" FontSize="470" FontWeight="Normal"
                                   Foreground="#4A2E1B"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,130,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="25" Color="#150802" Opacity="0.65" ShadowDepth="10" Direction="315"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Rectangle Width="90" Height="12" Fill="#A27B5C" RadiusX="6" RadiusY="6"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,75,85"/>
                    </Grid>
                </Border>
            </Viewbox>

            <!-- RESTAURANT — aceeași culoare ca bula -->
            <Viewbox Stretch="Uniform"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     Margin="-15,0,0,0">
                <TextBlock Text="Restaurant" 
                           FontFamily="Zapfino" 
                           FontWeight="Bold" 
                           FontStyle="Normal"
                           Foreground="#B3957D">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Viewbox>
        </Grid>

        <!-- BENGOS — maro închis -->
        <Viewbox Grid.Column="2"
                 Stretch="Uniform"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right"
                 Margin="0,-20,-45,-20">
            <TextBlock Text="Bengos" 
                       FontFamily="Zapfino" 
                       FontWeight="Bold" 
                       FontStyle="Normal"
                       Foreground="#4A2E1B">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Viewbox>

        <!-- BUTOANE + FOOTER — coloana din mijloc -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Right"
                        Margin="120,15,5,0">

                <Button VerticalAlignment="Stretch" Width="66"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Background="#4A2E1B"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,16,0"
                        Click="BtnLogin_Click">
                    <TextBlock FontSize="16" FontWeight="Bold"
                               TextAlignment="Center"
                               LineHeight="22"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        L<LineBreak/>O<LineBreak/>G<LineBreak/><LineBreak/>I<LineBreak/>N
                    </TextBlock>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#6D452B"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2A1508"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button VerticalAlignment="Stretch" Width="66"
                        FontWeight="Bold"
                        Foreground="#3F2314"
                        Background="#CBB5A1"
                        BorderBrush="#8C5C36"
                        BorderThickness="2"
                        Cursor="Hand"
                        Click="BtnViewMenu_Click">
                    <TextBlock FontSize="16" FontWeight="Bold"
                               TextAlignment="Center"
                               LineHeight="22"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        V<LineBreak/>I<LineBreak/>E<LineBreak/>W<LineBreak/><LineBreak/>M<LineBreak/>E<LineBreak/>N<LineBreak/>U
                    </TextBlock>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E0CEBD"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#6D452B"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#A6856B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,15,35,15"
                        Opacity="0.8">

                <TextBlock Text="© 2026 Bengos Restaurant"
                           FontSize="11"
                           Foreground="#4A2E1B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <Button Content="CLOSE"
                        Width="110" Height="32"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#4A2E1B"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnExit_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="16"
                                    BorderBrush="#6D5645"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#A27B5C"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#5C3A21"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>