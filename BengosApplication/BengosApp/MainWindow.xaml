<Window x:Class="BengosApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bengos Restaurant"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3EDEE"
        WindowStyle="None"
        AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="#F3EDEE" CornerRadius="22" Margin="10">

        <Border.Effect>
            <DropShadowEffect BlurRadius="35"
                              ShadowDepth="5"
                              Opacity="0.25"
                              Color="#4B2F3A"/>
        </Border.Effect>

        <Grid Margin="55">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CLOSE BUTTON -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,-35,-35,0" Width="30" Height="30" 
                    Background="#C9A3B5" Foreground="#5E3E4A" 
                    FontWeight="Bold" Click="BtnExit_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5E3E4A"/>
                                <Setter Property="Foreground" Value="#F3EDEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HEADER -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,55">

                <!-- LOGO -->
                <Border Width="110"
                        Height="110"
                        Background="#5E3E4A"
                        CornerRadius="55"
                        Margin="0,0,0,25">

                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                        <TextBlock Text="B"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   Foreground="#F3EDEE"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Rectangle Width="22"
                                   Height="3"
                                   Fill="#C9A3B5"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,18,20"/>
                    </Grid>
                </Border>

                <!-- TITLU -->
                <TextBlock Text="BENGOS"
                           FontSize="46"
                           FontWeight="SemiBold"
                           FontStyle="Italic"
                           FontFamily="Georgia"
                           Foreground="#4B2F3A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Restaurant"
                           FontSize="32"
                           FontWeight="Light"
                           Foreground="#7A5A68"
                           HorizontalAlignment="Center"
                           Margin="0,-6,0,0"/>

                <TextBlock Text="MANAGEMENT SYSTEM"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#8A6B7A"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="360">

                <!-- LOGIN -->
                <Button Content="LOG IN"
                        Height="54"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#F3EDEE"
                        Background="#5E3E4A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,18"
                        Click="BtnLogin_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="28">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#7A5A68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- VIEW MENU -->
                <Button Content="VIEW MENU"
                        Height="48"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#4B2F3A"
                        Background="#F3EDEE"
                        BorderBrush="#C9A3B5"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnViewMenu_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="24">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#E9DDE5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- FOOTER -->
            <TextBlock Grid.Row="2"
                       Text="© 2026 Bengos Restaurant"
                       FontSize="10"
                       Foreground="#8A6B7A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

        </Grid>
    </Border>
</Window>