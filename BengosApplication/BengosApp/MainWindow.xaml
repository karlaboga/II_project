<Window x:Class="BengosApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bengos Restaurant"
        Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAF0E6"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="#FAF0E6" CornerRadius="20" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.35" Color="#5C3A21"/>
        </Border.Effect>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Logo + Nume -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,0">
                <Border Width="90" Height="90" Background="#5C3A21"
                        CornerRadius="45" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="B" FontSize="44" FontWeight="Bold"
                               Foreground="#FAF0E6" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="bengos" FontSize="38" FontWeight="Light"
                           Foreground="#5C3A21" HorizontalAlignment="Center"/>
                <TextBlock Text="Restaurant" FontSize="38" FontWeight="Light"
                           Foreground="#8B5E3C" HorizontalAlignment="Center"
                           Margin="0,-6,0,0" />
                <TextBlock Text="MANAGEMENT SYSTEM" FontSize="10" FontWeight="Medium"
                           Foreground="#D4A574" HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
            <!-- Butoane -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="30,0">
                <Button Content="LOG IN" Height="48" FontSize="14" FontWeight="Bold"
                        Foreground="White" Background="#5C3A21" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,0,15"
                        Click="BtnLogin_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#8B5E3C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="VIEW MENU" Height="44" FontSize="13" FontWeight="SemiBold"
                        Foreground="#5C3A21" Background="#FFF8F0" BorderBrush="#E8D5B7"
                        BorderThickness="1" Cursor="Hand"
                        Click="BtnViewMenu_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#D4A574"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            <!-- Footer -->
            <TextBlock Grid.Row="2" Text="© 2026 Bengos Restaurant"
                       FontSize="9" Foreground="#D4A574"
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>
        </Grid>
    </Border>
</Window>