<Window x:Class="BengosApp.CookDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BengosApp"
        mc:Ignorable="d"
        Title="Kitchen Dashboard"
        Height="650"
        Width="1000"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F3EDEE"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- BORDER pentru colțuri rotunjite + shadow (FĂRĂ AllowsTransparency) -->
    <Border Background="#F3EDEE"
            CornerRadius="22"
            Margin="10">

        

        <Grid Margin="55">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CLOSE BUTTON -->
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-25,10,0"
                    Width="30"
                    Height="30"
                    Background="#C9A3B5"
                    Foreground="#5E3E4A"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="BtnClose_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">

                            <TextBlock Text="✕"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#5E3E4A"/>
                                <Setter Property="Foreground"
                                        Value="#F3EDEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HEADER -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,35"
                        HorizontalAlignment="Center">

                <TextBlock Text="KITCHEN DASHBOARD"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#5E3E4A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Kitchen orders and recipe management"
                           FontSize="12"
                           Foreground="#7A5A68"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>

            </StackPanel>

            <!-- MAIN CARDS -->
            <Grid Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- ACTIVE ORDERS -->
                <Border Grid.Column="0"
                        Background="#5E3E4A"
                        CornerRadius="18"
                        Padding="24"
                        Cursor="Hand"
                        MouseLeftButtonUp="OrdersButton_Click">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="📋"
                                   FontSize="50"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Active Orders"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#F3EDEE"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="View and manage incoming dish orders"
                                   FontSize="12"
                                   Foreground="#E9DDE5"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- COOKBOOK -->
                <Border Grid.Column="2"
                        Background="#C9A3B5"
                        CornerRadius="18"
                        Padding="24"
                        Cursor="Hand"
                        MouseLeftButtonUp="CookBookButton_Click">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="📖"
                                   FontSize="50"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="CookBook"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#5E3E4A"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Browse dishes and instructions"
                                   FontSize="12"
                                   Foreground="#7A5A68"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

         
        </Grid>
    </Border>
</Window>