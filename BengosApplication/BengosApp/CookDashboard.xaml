<Window x:Class="BengosApp.CookDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BengosApp"
        mc:Ignorable="d"
        Title="Kitchen Dashboard" Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDF9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30" HorizontalAlignment="Center">
            <TextBlock Text="KITCHEN DASHBOARD" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#4A2E1B" 
                      />
            <Separator Background="#8B5A2B" Height="3" Margin="0,5,0,0" Width="200"/>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Height="180"
                    Background="#8B5A2B" 
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OrdersButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="48" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Active Orders" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="View and manage incoming dish orders" FontSize="12" Margin="0,5,0,0" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" 
                    Height="180"
                    Background="#D2B48C" 
                    Foreground="#4A2E1B"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CookBookButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📖" FontSize="48" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="CookBook" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Browse dishes and instructions" FontSize="12" Margin="0,5,0,0" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

    </Grid>
</Window>