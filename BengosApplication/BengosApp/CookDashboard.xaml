<Window x:Class="BengosApp.CookDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BengosApp"
        mc:Ignorable="d"
        Title="Kitchen Dashboard" Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#FFFDF9">
    <Border Background="#FFFDF9" CornerRadius="20" BorderBrush="#8B5A2B" BorderThickness="2">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CLOSE BUTTON (X) -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,0,0,0" Width="30" Height="30" 
                    Background="#D2B48C" Foreground="#4A2E1B" 
                    FontWeight="Bold" Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B5A2B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Row="0" Margin="0,0,0,30" HorizontalAlignment="Center">
            <TextBlock Text="KITCHEN DASHBOARD" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#4A2E1B" 
                      />
            <Separator Background="#8B5A2B" Height="3" Margin="0,5,0,0" Width="200"/>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Height="180"
                    Background="#8B5A2B" 
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OrdersButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="48" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Active Orders" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="View and manage incoming dish orders" FontSize="12" Margin="0,5,0,0" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" 
                    Height="180"
                    Background="#D2B48C" 
                    Foreground="#4A2E1B"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CookBookButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📖" FontSize="48" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="CookBook" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Browse dishes and instructions" FontSize="12" Margin="0,5,0,0" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- BOTTOM CLOSE BUTTON -->
        <Button Grid.Row="2" Content="Close Dashboard" Width="150" Height="35" 
                Background="#8B5A2B" Foreground="White" FontWeight="Bold" 
                Cursor="Hand" Click="BtnClose_Click" Margin="0,20,0,0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#A06A3B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
    </Border>
</Window>