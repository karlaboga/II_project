<Window x:Class="BengosApp.MenuViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bengos Menu"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      CornerRadius="24" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#F2F1F0"
            CornerRadius="24"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid Margin="55">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="32" Height="32"
                    Background="Transparent" 
                    Foreground="#4A2D1C"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="BtnClose_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">

                            <TextBlock Text="✕"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#E5DFD9"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Button.Template>

            </Button>

            <TextBlock Grid.Row="0"
                       Text="🍽️ Our Menu"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#4A2D1C"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,10"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">

                <StackPanel.Resources>

                    <Style x:Key="FilterButtonStyle"
                           TargetType="Button">

                        <Setter Property="Background"
                                Value="#8B7365"/>

                        <Setter Property="Foreground"
                                Value="#F2F1F0"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="FontSize"
                                Value="11"/>

                        <Setter Property="Padding"
                                Value="12,5"/>

                        <Setter Property="Margin"
                                Value="3"/>

                        <Setter Property="Cursor"
                                Value="Hand"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="#735E52"/>

                                        </Trigger>

                                        <Trigger Property="Tag"
                                                 Value="Active">

                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="#4A2D1C"/>

                                            <Setter Property="Foreground"
                                                    Value="#F2F1F0"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </StackPanel.Resources>

                <Button Content="All"
                        x:Name="BtnAll"
                        Style="{StaticResource FilterButtonStyle}"
                        Click="Filter_Click"/>

                <Button Content="Main Course"
                        Style="{StaticResource FilterButtonStyle}"
                        Click="Filter_Click"/>

                <Button Content="Appetizers"
                        Style="{StaticResource FilterButtonStyle}"
                        Click="Filter_Click"/>

                <Button Content="Drinks"
                        Style="{StaticResource FilterButtonStyle}"
                        Click="Filter_Click"/>

                <Button Content="Desserts"
                        Style="{StaticResource FilterButtonStyle}"
                        Click="Filter_Click"/>

            </StackPanel>

            <ListBox Grid.Row="2"
                     x:Name="LstMenu"
                     Background="#F2F1F0"
                     BorderBrush="#E5DFD9"
                     Foreground="#4A2D1C"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>

                    <Style TargetType="ListBoxItem">

                        <Setter Property="Background"
                                Value="Transparent"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate TargetType="ListBoxItem">

                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#E5DFD9"/>

                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#E5DFD9"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border Background="#FFFFFF"
                                CornerRadius="10"
                                Padding="10"
                                Margin="2,3"
                                BorderBrush="#E5DFD9"
                                BorderThickness="1">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#4A2D1C"/>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="10"
                                               Foreground="#8B7365"/>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PriceDisplay}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#4A2D1C"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

            

            <TextBlock Text="⚠️ Missing ingredients"
                       Foreground="#8A3F4A"
                       FontSize="10"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom">

                <TextBlock.Style>

                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding HasMissingIngredients}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </TextBlock.Style>

            </TextBlock>

        </Grid>

    </Border>

</Window>