<Window x:Class="BengosApp.MenuViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bengos Menu"
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="🍽️ Our Menu" FontSize="22" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,5,0,10"/>
        <!-- Category filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="All" x:Name="BtnAll" Click="Filter_Click"
                    Background="#5C3A21" Foreground="White" BorderThickness="0"
                    FontSize="11" Padding="12,5" Margin="3" Cursor="Hand"/>
            <Button Content="Main Course" Click="Filter_Click"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    FontSize="11" Padding="12,5" Margin="3" Cursor="Hand"/>
            <Button Content="Appetizers" Click="Filter_Click"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    FontSize="11" Padding="12,5" Margin="3" Cursor="Hand"/>
            <Button Content="Drinks" Click="Filter_Click"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    FontSize="11" Padding="12,5" Margin="3" Cursor="Hand"/>
            <Button Content="Desserts" Click="Filter_Click"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    FontSize="11" Padding="12,5" Margin="3" Cursor="Hand"/>
        </StackPanel>
        <!-- Menu list -->
        <ListBox Grid.Row="2" x:Name="LstMenu"
                 Background="#FFF8F0" BorderBrush="#E8D5B7"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FAF0E6" CornerRadius="8" Padding="10" Margin="2,3"
                            BorderBrush="#E8D5B7" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                           Foreground="#5C3A21"/>
                                <TextBlock Text="{Binding Description}" FontSize="10"
                                           Foreground="#8B5E3C" TextWrapping="Wrap"
                                           Margin="0,2,10,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding PriceDisplay}"
                                       FontSize="16" FontWeight="Bold" Foreground="#5C3A21"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="3" Content="Close" Width="100" Height="32"
                Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                FontWeight="Bold" Cursor="Hand" Margin="0,10,0,5"
                HorizontalAlignment="Center" Click="BtnClose_Click"/>
        <TextBlock Text="⚠️ Missing ingredients"
           Foreground="#C94A4A" FontSize="10" FontWeight="Bold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMissingIngredients}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>