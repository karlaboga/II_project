<Window x:Class="BengosApp.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard"
Height="650" Width="1000"
MinHeight="650" MinWidth="1000"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
Background="#F2F1F0"
WindowStyle="None"
AllowsTransparency="True"
TextOptions.TextFormattingMode="Display"
TextOptions.TextRenderingMode="ClearType"
UseLayoutRounding="True"
        >

    <Border Background="#F2F1F0" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.08" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#4A2D1C" CornerRadius="24,0,0,24">
                <Grid Margin="30,45,25,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="5,0,0,50">
                        <TextBlock Text="BENGOS BISTRO" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="#F2F1F0"/>
                        <TextBlock Text="CORE HQ CONTROL" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   Foreground="#F2F1F0" 
                                   Opacity="0.5" 
                                   Margin="2,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top">

                        <Border Margin="0,0,0,16"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Cursor="Hand"
                                MouseLeftButtonUp="BtnInventory_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#5F3B26"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#8B7365"/>
                                            <Setter Property="BorderBrush" Value="#F2F1F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📦" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Inventory Control" FontSize="14" FontWeight="SemiBold" Foreground="#F2F1F0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Cursor="Hand"
                                MouseLeftButtonUp="BtnStaff_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#5F3B26"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#8B7365"/>
                                            <Setter Property="BorderBrush" Value="#F2F1F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="👥" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Staff &amp; Roster" FontSize="14" FontWeight="SemiBold" Foreground="#F2F1F0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Exit System"
                            Height="44"
                            Background="#8B7365"
                            Foreground="#F2F1F0"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Cursor="Hand"
                            Click="BtnLogout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#735E52"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="40,45,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,35">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWelcome"
                                   Text="Welcome back, Administrator"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#4A2D1C"/>
                        <TextBlock Text="System status active • Monitor and manage daily operations"
                                   FontSize="13"
                                   Foreground="#8B7365"
                                   Opacity="0.9"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Width="32" Height="32" 
                            Background="Transparent" Foreground="#4A2D1C" 
                            FontWeight="Normal" FontSize="13" Click="BtnLogout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                                    <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E5DFD9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,15" Background="#FFFFFF" BorderBrush="#E5DFD9" BorderThickness="1" CornerRadius="16" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.02" Color="#4A2D1C"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SYSTEM NOTIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="#4A2D1C" Opacity="0.4" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Automated tracking of kitchen and central warehouse stock. Click the button below to generate a complete diagnostics report of ingredients currently below the optimal safety threshold." FontSize="12" Foreground="#4A2D1C" TextWrapping="Wrap" Opacity="0.85" VerticalAlignment="Top" LineHeight="18"/>

                            <Button Grid.Row="2" Content="⚠  Launch Low Stock Warning Diagnostics"
                                    Height="48"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Foreground="#F3EDEE"
                                    Background="#8A3F4A"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnLowStock_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.1" Color="#8A3F4A"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#A05563"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,15,0,0" Background="#FFFFFF" BorderBrush="#E5DFD9" BorderThickness="1" CornerRadius="16" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.02" Color="#4A2D1C"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="FINANCIAL OPERATIONS &amp; LEDGER" FontSize="11" FontWeight="Bold" Foreground="#4A2D1C" Opacity="0.4" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Secure access to the restaurant's financial ledgers. You can manage employee payroll or view real-time revenue breakdowns from POS terminals, online orders, and deliveries." FontSize="12" Foreground="#4A2D1C" TextWrapping="Wrap" Opacity="0.85" VerticalAlignment="Top" LineHeight="18"/>

                            <UniformGrid Grid.Row="2" Columns="2" HorizontalAlignment="Stretch">
                                <Button Content="💵  Payroll &amp; Salary"
                                        Height="50"
                                        Margin="0,0,8,0"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="#F2F1F0"
                                        Background="#4A2D1C"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnSalary_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#4A2D1C"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#5F3B26"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="📊  Revenue Reports"
                                        Height="50"
                                        Margin="8,0,0,0"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="#F2F1F0"
                                        Background="#8B7365"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnRevenue_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#4A2D1C"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#735E52"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>