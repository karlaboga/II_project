<Window x:Class="BengosApp.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard"
Height="650" Width="1000"
MinHeight="650" MinWidth="1000"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
Background="#F3EDEE"
WindowStyle="None"
AllowsTransparency="True"
        >


    <Border Background="#F3EDEE" CornerRadius="22" Margin="10">

       

                <Grid Margin="55">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                    

            <!-- CLOSE BUTTON -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,-25,10,0" Width="30" Height="30" 
                    Background="#C9A3B5" Foreground="#5E3E4A" 
                    FontWeight="Bold" Click="BtnLogout_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5E3E4A"/>
                                <Setter Property="Foreground" Value="#F3EDEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HEADER (CHANGED TEXT) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">

                <TextBlock x:Name="TxtWelcome"
                           Text="ADMIN DASHBOARD"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#4B2F3A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Restaurant management overview"
                           FontSize="12"
                           Foreground="#7A5A68"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <!-- TOP CARDS -->
            <Grid Grid.Row="1" HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <!-- INVENTORY -->
                <Border Grid.Column="0"
                        Margin="10"
                        Background="#F3EDEE"
                        BorderBrush="#C9A3B5"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Cursor="Hand"
                        MouseLeftButtonUp="BtnInventory_Click">

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Inventory"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#4B2F3A"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2"/>
                        <TextBlock Text="Products management"
                                   FontSize="10"
                                   Foreground="#7A5A68"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- STAFF -->
                <Border Grid.Column="1"
                        Margin="10"
                        Background="#F3EDEE"
                        BorderBrush="#C9A3B5"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Cursor="Hand"
                        MouseLeftButtonUp="BtnStaff_Click">

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👥" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Staff"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#4B2F3A"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2"/>
                        <TextBlock Text="Shifts &amp; scheduling"
                                   FontSize="10"
                                   Foreground="#7A5A68"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ACTION BUTTONS (WITH UNIFORM STYLE) -->
            <StackPanel Grid.Row="2"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center">

                <!-- LOW STOCK -->
                <Button Content="⚠ Low Stock"
                        Width="260"
                        Height="42"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold"
                        Foreground="#F3EDEE"
                        Background="#8A3F4A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnLowStock_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#A05563"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- HOURS -->
                <Button Content="⏱ Hours"
                        Width="260"
                        Height="42"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold"
                        Foreground="#F3EDEE"
                        Background="#7A5A68"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnHours_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#92707E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- SALARY -->
                <Button Content="💵 Salary"
                        Width="260"
                        Height="42"
                        Margin="0,0,0,10"
                        FontWeight="SemiBold"
                        Foreground="#F3EDEE"
                        Background="#5E3E4A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnSalary_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#7A5561"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- REVENUE -->
                <Button Content="📊 Revenue"
                        Width="260"
                        Height="42"
                        FontWeight="SemiBold"
                        Foreground="#F3EDEE"
                        Background="#4B2F3A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnRevenue_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#5E3E4A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- LOGOUT -->
            <Button Grid.Row="4"
                    Content="Logout"
                    Width="140"
                    Height="42"
                    Background="#E9DDE5"
                    Foreground="#4B2F3A"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Margin="0,22,0,0"
                    Click="BtnLogout_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#D6C6CF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>
    </Border>
</Window>