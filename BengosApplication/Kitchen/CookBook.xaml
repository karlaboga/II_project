<Window x:Class="Kitchen.CookBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kitchen CookBook" Height="650" Width="1000"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      CornerRadius="24" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RecipeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F1F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2F1F0" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Stanga -->
            <Border Background="#E5DFD9" CornerRadius="24,0,0,24">
                <Grid Margin="15,25,15,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Filter Category:" FontSize="14" FontWeight="SemiBold" Foreground="#4A2D1C" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryFilterComboBox" Height="35" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="CategoryFilterComboBox_SelectionChanged" BorderBrush="#8B7365" Background="#F2F1F0">
                            <ComboBoxItem Content="All Dishes"/>
                            <ComboBoxItem Content="Appetizers"/>
                            <ComboBoxItem Content="Main Course"/>
                            <ComboBoxItem Content="Drinks"/>
                            <ComboBoxItem Content="Desserts"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Search Dish:" FontSize="14" FontWeight="SemiBold" Foreground="#4A2D1C" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="2" x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15" BorderBrush="#8B7365" Background="#F2F1F0"/>

                    <ListBox Grid.Row="3" x:Name="RecipeListBox" Background="Transparent" BorderThickness="0" DisplayMemberPath="Name">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Foreground" Value="#4A2D1C"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D1C7BD"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#4A2D1C"/>
                                        <Setter Property="Foreground" Value="#F2F1F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Continut Dreapta -->
            <Grid Grid.Column="1" Margin="35,25,25,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtDishName" Text="Select a Recipe" FontSize="28" FontWeight="Bold" Foreground="#4A2D1C"/>
                        <WrapPanel Margin="0,8,0,0" Height="34">
                            <TextBlock Text="⏱️ Prep Time: " FontSize="14" Foreground="#8B7365" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtPrepTime" Text="--" FontSize="14" Foreground="#8B7365"/>
                            <TextBlock Text="  ⚠️ Allergens: " FontSize="14" Foreground="#8A3F4A" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtAllergens" Text="--" FontSize="14" Foreground="#8A3F4A"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Zona Butoane Actiuni Reteta -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnAddRecipe" Content="➕ Add" Style="{StaticResource RecipeButtonStyle}" Click="BtnAddRecipe_Click" Width="80" Height="35" Margin="0,0,8,0" Background="#8B7365"/>
                        <Button x:Name="BtnEditRecipe" Content="✏️ Edit" Style="{StaticResource RecipeButtonStyle}" Click="BtnEditRecipe_Click" Width="80" Height="35" Margin="0,0,8,0" Background="#4A2D1C"/>
                        <Button x:Name="BtnDeleteRecipe" Content="🗑️ Delete" Style="{StaticResource RecipeButtonStyle}" Click="BtnDeleteRecipe_Click" Width="80" Height="35" Margin="0,0,15,0" Background="#8A3F4A"/>

                        <Button x:Name="BtnBack" Width="32" Height="32" Background="Transparent" Foreground="#4A2D1C" FontWeight="Bold" Click="BtnBack_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="xBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="xBorder" Property="Background" Value="#E5DFD9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Background="#E5DFD9" Height="1" Margin="0,15"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="INGREDIENTS" FontSize="16" FontWeight="Bold" Foreground="#8B7365" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtIngredients" Text="No ingredients to display." FontSize="15" Foreground="#4A2D1C"/>
                </StackPanel>

                <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Top" Text="PREPARATION INSTRUCTIONS" FontSize="16" FontWeight="Bold" Foreground="#8B7365" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtInstructions" Text="Select a dish from the sidebar menu to read instructions." FontSize="15" Foreground="#4A2D1C" TextWrapping="Wrap" LineHeight="22"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>