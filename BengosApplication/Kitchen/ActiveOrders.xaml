<Window x:Class="Kitchen.ActiveOrders"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kitchen"
        mc:Ignorable="d"
        Title="Active Kitchen Orders" Height="650" Width="1000"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      CornerRadius="24" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#F2F1F0" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20">

                <Button DockPanel.Dock="Right"
                        Width="32" Height="32" Background="Transparent" Foreground="#4A2D1C"
                        FontWeight="Bold" Cursor="Hand" Click="Button_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E5DFD9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="🔄 Refresh"
                        Width="85" Height="30"
                        Margin="10,0,0,0"
                        Background="#8B7365"
                        Foreground="#F2F1F0"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnRefresh_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#735E52"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="ACTIVE KITCHEN ORDERS"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#4A2D1C"
                           HorizontalAlignment="Center"
                           Margin="0,0,155,0"/>
            </DockPanel>

            <Border Grid.Row="1"
                    CornerRadius="8"
                    BorderThickness="3"
                    BorderBrush="#8B7365">

                <Border.Background>
                    <SolidColorBrush Color="#FFFFFF" Opacity="0.95"/>
                </Border.Background>

                <Grid Margin="15">

                    <TextBlock x:Name="TxtWaitingMessage"
                               Text="Waiting for incoming orders..."
                               FontSize="16"
                               Foreground="#4A2D1C"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=OrdersControl}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="OrdersControl">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Width="230"
                                            Margin="10"
                                            Background="#F2F1F0"
                                            BorderBrush="#8B7365"
                                            BorderThickness="2.5"
                                            CornerRadius="8">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6"
                                                              ShadowDepth="4"
                                                              Opacity="0.15"
                                                              Color="#4A2D1C"/>
                                        </Border.Effect>

                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Background="#4A2D1C"
                                                    Padding="6,4,6,4"
                                                    CornerRadius="4"
                                                    Margin="0,0,0,12">

                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OrderDisplay}" FontWeight="Bold" Foreground="#F2F1F0" FontSize="15"/>
                                                        <TextBlock Text=" — " FontWeight="Bold" Foreground="#8B7365" FontSize="15"/>
                                                        <TextBlock Text="{Binding TableNumber, StringFormat='Table {0}'}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="15"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Timestamp, StringFormat=\{0:HH:mm\}}" Foreground="#F2F1F0" Opacity="0.8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl Grid.Row="1"
                                                          ItemsSource="{Binding Items}"
                                                          MinHeight="70"
                                                          Margin="0,0,0,10">

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>

                                                        <TextBlock Margin="0,4,0,4"
                                                                   FontSize="14"
                                                                   Foreground="#4A2D1C"
                                                                   TextWrapping="Wrap">
                                                            <Run Text="• " FontWeight="Bold" Foreground="#8B7365"/>
                                                            <Run Text="{Binding Quantity}" FontWeight="Bold"/>
                                                            <Run Text="x " Foreground="#8B7365"/>
                                                            <Run Text="{Binding Name}"/>
                                                        </TextBlock>

                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        Margin="0,5,0,12">

                                                <TextBlock Text="⏱ Est. Time: "
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8B7365"/>

                                                <TextBlock Text="{Binding TotalPrepTime}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#4A2D1C"/>

                                                <TextBlock Text=" mins"
                                                           FontSize="13"
                                                           Foreground="#8B7365"/>
                                            </StackPanel>

                                            <Button Grid.Row="3"
                                                    Content="✔ Complete Order"
                                                    Click="BtnCompleteOrder_Click"
                                                    DataContext="{Binding}"
                                                    Background="#4A2D1C"
                                                    Foreground="#F2F1F0"
                                                    FontWeight="Bold"
                                                    Height="32"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#5F3B26"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>