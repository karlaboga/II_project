@model IEnumerable<BengosMenu.Models.Dish>
@{
    ViewData["Title"] = "Category - " + ViewBag.Category;
}
<style>
    .page-header {
        color: #76938e;
        padding: 50px 0 40px 0;
    }

    .dish-card {
        background-color: #b8b8aa;
        border: 1px solid #988071;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        transition: transform 0.3s;
    }

        .dish-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .dish-name {
        color: #76938e;
        font-size: 1.3rem;
        font-weight: 600;
    }

    .dish-price {
        color: #7f9183;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .dish-description {
        color: #988071;
    }

    .ingredient-badge {
        display: inline-block;
        background-color: #cfc0bd;
        color: #7f9183;
        padding: 5px 12px;
        border-radius: 20px;
        margin: 3px;
        font-size: 0.85rem;
    }
</style>
<div class="container">
    <div class="row page-header">
        <div class="col-12">
            <a href="@Url.Action("Index", "Menu")" style="color: #988071;">← Back to Categories</a>
            <h1>@ViewBag.Category</h1>
        </div>
    </div>
    <div class="row">
        @foreach (var dish in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="dish-card">
                    <div class="dish-name">@dish.Name</div>
                    <div class="dish-price">$@dish.Price.ToString("0.00")</div>
                    @if (!string.IsNullOrEmpty(dish.Description))
                    {
                        <div class="dish-description">@dish.Description</div>
                    }
                    @if (dish.DishIngredients?.Any() == true)
                    {
                        <div>
                            <small style="color: #7f9183;">Ingredients:</small><br />
                            @foreach (var ing in dish.DishIngredients)
                            {
                                <span class="ingredient-badge">@ing.Produs.Name (@ing.Quantity @ing.Produs.Unit)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    @if (!Model.Any())
    {
        <div class="text-center" style="padding: 50px;">
            <p style="color: #7f9183;">No dishes found in this category.</p>
        </div>
    }
</div>