<Window x:Class="StaffManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Login"
        Height="650" Width="1000"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      CornerRadius="24" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#F2F1F0" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#4A2D1C" CornerRadius="24,0,0,24">
                <Grid Margin="50,60,50,60">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="BENGOS BISTRO" FontSize="24" FontWeight="Bold" Foreground="#F2F1F0"/>
                        <TextBlock Text="STAFF HUB SYSTEM" FontSize="11" FontWeight="Bold" Foreground="#F2F1F0" Opacity="0.4" Margin="2,6,0,0" FontStretch="Expanded"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="Welcome to your workspace." FontSize="28" FontWeight="Light" Foreground="#F2F1F0" TextWrapping="Wrap" LineHeight="36"/>
                        <TextBlock Text="Connect securely to manage inventory, update schedules, and track restaurant operations in real-time." FontSize="13" Foreground="#F2F1F0" TextWrapping="Wrap" Opacity="0.6" Margin="0,16,0,0" LineHeight="20"/>
                    </StackPanel>

                   
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="60,45,60,60">
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Background="Transparent" Foreground="#4A2D1C"
                        FontWeight="Bold" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E5DFD9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">

                    <TextBlock Text="Account Login"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#4A2D1C"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Enter your secure credentials below to check-in."
                               FontSize="13"
                               Foreground="#8B7365"
                               Margin="0,0,0,35"/>

                    <TextBlock Text="Username"
                               Foreground="#8B7365"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="txtUsername"
                             Height="46"
                             Background="#FFFFFF"
                             Foreground="#4A2D1C"
                             FontSize="14"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,22"
                             BorderThickness="1"
                             BorderBrush="#E5DFD9"
                             KeyDown="PasswordField_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10"
                                                    SnapsToDevicePixels="True">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#8B7365"/>
                                                </Trigger>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#4A2D1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="Password"
                               Foreground="#8B7365"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,30">
                        <PasswordBox x:Name="txtPassword"
                                     Height="46"
                                     Background="#FFFFFF"
                                     Foreground="#4A2D1C"
                                     FontSize="14"
                                     Padding="12,0,46,0"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="1"
                                     BorderBrush="#E5DFD9"
                                     KeyDown="PasswordField_KeyDown">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#8B7365"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#4A2D1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <TextBox x:Name="txtPasswordVisible"
                                 Height="46"
                                 Background="#FFFFFF"
                                 Foreground="#4A2D1C"
                                 FontSize="14"
                                 Padding="12,0,46,0"
                                 BorderThickness="1"
                                 BorderBrush="#E5DFD9"
                                 Visibility="Collapsed"
                                 VerticalContentAlignment="Center"
                                 KeyDown="PasswordField_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#8B7365"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#4A2D1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button x:Name="BtnShowPassword"
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnShowPassword_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <TextBlock x:Name="EyeIcon"
                                                   Text="👁"
                                                   FontSize="15"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#8B7365"
                                                   Opacity="0.7">
                                            <TextBlock.FontFamily>
                                                <FontFamily>Segoe UI Emoji</FontFamily>
                                            </TextBlock.FontFamily>
                                        </TextBlock>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Button Content="Sign In"
                            Height="48"
                            Background="#4A2D1C"
                            Foreground="#F2F1F0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnLogin_Click"
                            Margin="0,0,0,15">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.15" Color="#4A2D1C"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5F3B26"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="lblError"
                               Foreground="#8A3F4A"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>