<Window x:Class="StaffManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Login"
        Height="650" Width="1000"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F3EDEE"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

   

        <Grid Margin="60">

            <!-- CLOSE BUTTON -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,-40,-40,0" Width="30" Height="30" 
                    Background="#C9A3B5" Foreground="#5E3E4A" 
                    FontWeight="Bold" Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5E3E4A"/>
                                <Setter Property="Foreground" Value="#F3EDEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Grid VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Width="380">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE -->
                <TextBlock Grid.Row="0"
                           Text="STAFF LOGIN"
                           FontSize="34"
                           FontWeight="SemiBold"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           Foreground="#4B2F3A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- USERNAME -->
                <TextBlock Grid.Row="1"
                           Text="Username"
                           Foreground="#7A5A68"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <!-- USERNAME BOX (NO BLUE EVER) -->
                <TextBox x:Name="txtUsername"
                         Grid.Row="2"
                         Height="44"
                         Background="#F3EDEE"
                         Foreground="#4B2F3A"
                         FontSize="14"
                         Padding="10"
                         Margin="0,0,0,18"
                         BorderThickness="1"
                         BorderBrush="#C9A3B5">

                    <TextBox.Style>
                        <Style TargetType="TextBox">

                            <!-- remove default WPF blue glow -->
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">

                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="0"/>
                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <!-- hover -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border"
                                                        Property="BorderBrush"
                                                        Value="#7A5A68"/>
                                            </Trigger>

                                            <!-- focus -->
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="border"
                                                        Property="BorderBrush"
                                                        Value="#5E3E4A"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- PASSWORD -->
                <TextBlock Grid.Row="3"
                           Text="Password"
                           Foreground="#7A5A68"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="4"
                             Height="44"
                             Background="#F3EDEE"
                             Foreground="#4B2F3A"
                             FontSize="14"
                             Padding="10"
                             Margin="0,0,0,25"
                             BorderThickness="1"
                             BorderBrush="#C9A3B5">

                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">

                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">

                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border"
                                                        Property="BorderBrush"
                                                        Value="#7A5A68"/>
                                            </Trigger>

                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="border"
                                                        Property="BorderBrush"
                                                        Value="#5E3E4A"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <!-- BUTTON -->
                <Button Grid.Row="5"
                        Content="LOGIN"
                        Height="48"
                        Background="#5E3E4A"
                        Foreground="#F3EDEE"
                        FontSize="16"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnLogin_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#7A5A68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ERROR -->
                <TextBlock x:Name="lblError"
                           Grid.Row="5"
                           Foreground="#8A3F4A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,-28"
                           FontSize="12"/>

            </Grid>
        </Grid>
    
</Window>