<Window x:Class="StaffManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Login" Height="350" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Staff Management"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#5C3A21"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,30"/>
        <TextBlock Grid.Row="1" Text="Username:"
                   Foreground="#8B5E3C" FontWeight="SemiBold"
                   FontSize="14" Margin="0,0,0,4"/>
        <TextBox x:Name="txtUsername" Grid.Row="2"
                 Background="#FFF8F0" Foreground="#5C3A21"
                 BorderBrush="#E8D5B7"
                 FontSize="14" Padding="8"
                 Margin="0,0,0,15"/>
        <TextBlock Grid.Row="3" Text="Password:"
                   Foreground="#8B5E3C" FontWeight="SemiBold"
                   FontSize="14" Margin="0,0,0,4"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="4"
                     Background="#FFF8F0" Foreground="#5C3A21"
                     BorderBrush="#E8D5B7"
                     FontSize="14" Padding="8"
                     Margin="0,0,0,20"/>
        <Button Grid.Row="5" Content="Login"
                Background="#D4A574" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                FontSize="16" FontWeight="Bold"
                Padding="10,12"
                Click="BtnLogin_Click"/>
        <TextBlock x:Name="lblError" Grid.Row="5"
                   Foreground="#C94A4A"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,10" FontSize="12"/>
    </Grid>
</Window>