<Window x:Class="StaffManagement.SalaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salary Report"
        Height="650" Width="1000"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
WindowStyle="None"
AllowsTransparency="True"
Background="#F3EDEE"
FontFamily="Segoe UI"
TextOptions.TextFormattingMode="Display"
TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="💵 Salary Report"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#5E3E4A"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,15"/>

        <!-- DATA GRID -->
        <DataGrid Grid.Row="1"
                  x:Name="DgSalary"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#F3EDEE"
                  BorderBrush="#C9A3B5"
                  Foreground="#5E3E4A"
                  RowBackground="#F3EDEE"
                  AlternatingRowBackground="#E9DDE5"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Resources>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5E3E4A"/>
                    <Setter Property="Foreground" Value="#F3EDEE"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Total Shifts" Binding="{Binding TotalShifts}" Width="85"/>
                <DataGridTextColumn Header="Morning" Binding="{Binding MorningShifts}" Width="70"/>
                <DataGridTextColumn Header="Evening" Binding="{Binding EveningShifts}" Width="70"/>
                <DataGridTextColumn Header="Night" Binding="{Binding NightShifts}" Width="70"/>
                <DataGridTextColumn Header="Total Hours" Binding="{Binding TotalHours}" Width="85"/>
                <DataGridTextColumn Header="Hourly Rate" Binding="{Binding HourlyRateDisplay}" Width="100"/>
                <DataGridTextColumn Header="Total Salary" Binding="{Binding TotalSalaryDisplay}" Width="110"/>
            </DataGrid.Columns>

        </DataGrid>

        <!-- BUTTON -->
        <Button Grid.Row="2"
        Content="Close"
        Width="110"
        Height="38"
        Background="#C9A3B5"
        Foreground="#2F1E18"
        BorderThickness="0"
        FontWeight="Bold"
        Cursor="Hand"
        Margin="0,10,0,0"
        HorizontalAlignment="Center"
        Click="BtnClose_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">

                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#B896A3"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#A57F90"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

        </Button>

    </Grid>
</Window>