<Window x:Class="StaffManagement.SalaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salary Report"
        Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="💵 Salary Report" FontSize="20" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,5,0,15"/>
        <DataGrid Grid.Row="1" x:Name="DgSalary" AutoGenerateColumns="False"
                  IsReadOnly="True" Background="#FFF8F0" BorderBrush="#E8D5B7"
                  Foreground="#5C3A21" RowBackground="#FFF8F0"
                  AlternatingRowBackground="#FAF0E6"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Hourly Rate" Binding="{Binding HourlyRateDisplay}" Width="100"/>
                <DataGridTextColumn Header="Total Hours" Binding="{Binding TotalHours}" Width="100"/>
                <DataGridTextColumn Header="Total Salary" Binding="{Binding TotalSalaryDisplay}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="Close" Width="100" Height="32"
                Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                FontWeight="Bold" Cursor="Hand" Margin="0,10,0,0"
                HorizontalAlignment="Center" Click="BtnClose_Click"/>
    </Grid>
</Window>