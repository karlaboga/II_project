<Window x:Class="StaffManagement.HoursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hours Worked"
        Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="⏱️ Hours Worked" FontSize="20" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,5,0,15"/>
        <DataGrid Grid.Row="1" x:Name="DgHours" AutoGenerateColumns="False"
                  IsReadOnly="True" Background="#FFF8F0" BorderBrush="#E8D5B7"
                  Foreground="#5C3A21" RowBackground="#FFF8F0"
                  AlternatingRowBackground="#FAF0E6"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Total Shifts" Binding="{Binding TotalShifts}" Width="100"/>
                <DataGridTextColumn Header="Morning" Binding="{Binding MorningShifts}" Width="80"/>
                <DataGridTextColumn Header="Evening" Binding="{Binding EveningShifts}" Width="80"/>
                <DataGridTextColumn Header="Night" Binding="{Binding NightShifts}" Width="80"/>
                <DataGridTextColumn Header="Total Hours" Binding="{Binding TotalHours}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="Close" Width="100" Height="32"
                Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                FontWeight="Bold" Cursor="Hand" Margin="0,10,0,0"
                HorizontalAlignment="Center" Click="BtnClose_Click"/>
    </Grid>
</Window>