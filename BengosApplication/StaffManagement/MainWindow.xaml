<Window x:Class="StaffManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Management - Shift Scheduling" Height="600" Width="900"
        Background="#FAF0E6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Shift Management"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#5C3A21"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Staff:"
                       Foreground="#8B5E3C" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding StaffList}"
                      SelectedItem="{Binding SelectedStaff, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsAdmin}"
                      Background="#FFF8F0" Foreground="#5C3A21"
                      BorderBrush="#E8D5B7"
                      FontSize="13" Padding="4"/>
            <TextBlock Grid.Column="2" Text="Day:"
                       Foreground="#8B5E3C" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,8,0"/>
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding DayList}"
                      SelectedItem="{Binding SelectedDay, UpdateSourceTrigger=PropertyChanged}"
                      Background="#FFF8F0" Foreground="#5C3A21"
                      BorderBrush="#E8D5B7"
                      FontSize="13" Padding="4"/>
            <TextBlock Grid.Column="4" Text="Shift:"
                       Foreground="#8B5E3C" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,8,0"/>
            <ComboBox Grid.Column="5"
                      ItemsSource="{Binding ShiftTypeList}"
                      SelectedItem="{Binding SelectedShiftType, UpdateSourceTrigger=PropertyChanged}"
                      Background="#FFF8F0" Foreground="#5C3A21"
                      BorderBrush="#E8D5B7"
                      FontSize="13" Padding="4"/>
            <CheckBox Grid.Column="6" Content="Overtime"
                      IsChecked="{Binding Overtime}"
                      Foreground="#8B5E3C" FontWeight="SemiBold"
                      VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Add"
                    Background="#D4A574" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    FontSize="14" FontWeight="Bold"
                    Padding="50,10" Margin="0,0,10,0"
                    Command="{Binding AddCommand}"/>
            <Button Grid.Column="1" Content="Delete"
                    Background="#C94A4A" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    FontSize="14" FontWeight="Bold"
                    Padding="40,10" Margin="0,0,10,0"
                    Command="{Binding DeleteCommand}"/>
            <Button Grid.Column="2" Content="Clear All"
                    Background="#E8D5B7" Foreground="#5C3A21"
                    BorderThickness="0" Cursor="Hand"
                    FontSize="14" FontWeight="Bold"
                    Padding="40,10"
                    Command="{Binding ClearAllCommand}"/>
        </Grid>
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Shifts}"
                  SelectedItem="{Binding SelectedShift, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FFF8F0" BorderBrush="#E8D5B7"
                  Foreground="#5C3A21" RowBackground="#FFF8F0"
                  AlternatingRowBackground="#FAF0E6"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="35"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#D4A574"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Staff" Binding="{Binding Staff}" Width="*"/>
                <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/>
                <DataGridTextColumn Header="Shift Type" Binding="{Binding ShiftType}" Width="*"/>
                <DataGridTextColumn Header="Overtime" Binding="{Binding OvertimeText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>