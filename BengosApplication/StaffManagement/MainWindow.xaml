<Window x:Class="StaffManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Management - Shift Scheduling"
        Height="650" Width="1000"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
WindowStyle="None"
AllowsTransparency="True"
Background="#F3EDEE"
FontFamily="Segoe UI"
TextOptions.TextFormattingMode="Display"
TextOptions.TextRenderingMode="ClearType">

    <Border Background="#F3EDEE" Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#5E3E4A"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,15">

                <TextBlock Text="Staff Management"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#F3EDEE"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- FILTER BAR -->
            <Border Grid.Row="1"
                    Background="#F3EDEE"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,15"
                    BorderBrush="#C9A3B5"
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Staff"
                                   Foreground="#7A5A68"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding StaffList}"
                                  SelectedItem="{Binding SelectedStaff}"
                                  IsEnabled="{Binding IsAdmin}"
                                  Background="#F3EDEE"
                                  BorderBrush="#C9A3B5"
                                  Foreground="#4B2F3A"
                                  Padding="5"/>
                        <TextBlock Text="{Binding SelectedStaffRole}"
                                   Foreground="#5E3E4A"
                                   FontStyle="Italic"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Date"
                                   Foreground="#7A5A68"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding SelectedDate}"
                                     Background="#F3EDEE"
                                     BorderBrush="#C9A3B5"
                                     Foreground="#4B2F3A"
                                     Validation.ErrorTemplate="{x:Null}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Shift"
                                   Foreground="#7A5A68"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding ShiftTypeList}"
                                  SelectedItem="{Binding SelectedShiftType}"
                                  Background="#F3EDEE"
                                  BorderBrush="#C9A3B5"
                                  Foreground="#4B2F3A"
                                  Padding="5"/>
                    </StackPanel>

                    <CheckBox Grid.Column="3"
                              Content="Overtime"
                              IsChecked="{Binding Overtime}"
                              Foreground="#7A5A68"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"/>
                </Grid>
            </Border>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15">

                <!-- SEARCH -->
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        Foreground="#F3EDEE"
                        FontWeight="SemiBold"
                        Padding="30,10"
                        Margin="5"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#4B6A7A"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#6A8A9A"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#3A5A6A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- REFRESH -->
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Foreground="#F3EDEE"
                        FontWeight="SemiBold"
                        Padding="30,10"
                        Margin="5"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#6B8A6A"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#8AAA8A"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#4B6A4A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ADD -->
                <Button Content="Add Shift"
                        Command="{Binding AddCommand}"
                        Foreground="#F3EDEE"
                        FontWeight="SemiBold"
                        Padding="30,10"
                        Margin="5"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#5E3E4A"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#7A5A68"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#4B2F3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- DELETE -->
                <Button Content="Delete"
                        Command="{Binding DeleteCommand}"
                        Foreground="#F3EDEE"
                        FontWeight="SemiBold"
                        Padding="30,10"
                        Margin="5"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#8A3F4A"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#6E2F38"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#4A1F25"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- CLEAR -->
                <Button Content="Clear All"
                        Command="{Binding ClearAllCommand}"
                        Foreground="#4B2F3A"
                        FontWeight="SemiBold"
                        Padding="30,10"
                        Margin="5"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#E9DDE5"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#D6C2CE"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#BFA9B6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- CLOSE -->
                <Button Content="Close"
                        Click="BtnClose_Click"
                        Foreground="#F3EDEE"
                        FontWeight="SemiBold"
                        Padding="30,10"
                        Margin="5"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#8A6B7A"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#7A5A68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- DATA GRIDS -->
            <Border Grid.Row="3"
                    Background="#F3EDEE"
                    CornerRadius="12"
                    BorderBrush="#C9A3B5"
                    BorderThickness="1"
                    Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Admin Grid -->
                    <Grid Grid.Column="0" Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#5E3E4A" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="Admin" Foreground="#F3EDEE" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AdminShifts}"
                                  SelectedItem="{Binding SelectedShift}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#F3EDEE" BorderThickness="0"
                                  Foreground="#4B2F3A" RowBackground="#F3EDEE"
                                  AlternatingRowBackground="#E9DDE5"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#5E3E4A"/>
                                    <Setter Property="Foreground" Value="#F3EDEE"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#C9A3B5"/>
                                            <Setter Property="Foreground" Value="#2F1E18"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Staff" Binding="{Binding Staff}" Width="*"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftType}" Width="*"/>
                                <DataGridTextColumn Header="OT" Binding="{Binding OvertimeText}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Employee Grid -->
                    <Grid Grid.Column="1" Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#7A5A68" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="Employee" Foreground="#F3EDEE" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding EmployeeShifts}"
                                  SelectedItem="{Binding SelectedShift}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#F3EDEE" BorderThickness="0"
                                  Foreground="#4B2F3A" RowBackground="#F3EDEE"
                                  AlternatingRowBackground="#E9DDE5"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#7A5A68"/>
                                    <Setter Property="Foreground" Value="#F3EDEE"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#C9A3B5"/>
                                            <Setter Property="Foreground" Value="#2F1E18"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Staff" Binding="{Binding Staff}" Width="*"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftType}" Width="*"/>
                                <DataGridTextColumn Header="OT" Binding="{Binding OvertimeText}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Cook Grid -->
                    <Grid Grid.Column="2" Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#8A6B7A" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="Cook" Foreground="#F3EDEE" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CookShifts}"
                                  SelectedItem="{Binding SelectedShift}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#F3EDEE" BorderThickness="0"
                                  Foreground="#4B2F3A" RowBackground="#F3EDEE"
                                  AlternatingRowBackground="#E9DDE5"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#8A6B7A"/>
                                    <Setter Property="Foreground" Value="#F3EDEE"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#C9A3B5"/>
                                            <Setter Property="Foreground" Value="#2F1E18"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Staff" Binding="{Binding Staff}" Width="*"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftType}" Width="*"/>
                                <DataGridTextColumn Header="OT" Binding="{Binding OvertimeText}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>