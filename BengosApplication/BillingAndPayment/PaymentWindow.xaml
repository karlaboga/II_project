<Window x:Class="BillingAndPayment.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F3EDEE"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="Payment Method"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#5E3E4A"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- AMOUNT -->
        <TextBlock Grid.Row="1"
                   Text="Total Amount:"
                   FontWeight="SemiBold"
                   Foreground="#7A5A68"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2"
                   x:Name="TxtAmount"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#5E3E4A"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,25"/>

        <!-- PAYMENT OPTIONS -->
        <Border Grid.Row="3"
                Background="#F3EDEE"
                BorderBrush="#C9A3B5"
                BorderThickness="1"
                CornerRadius="12"
                Padding="15"
                Margin="40,0">

            <StackPanel>

                <RadioButton x:Name="RbCard"
                             Content="   Card Payment"
                             IsChecked="True"
                             GroupName="PaymentMethod"
                             Foreground="#5E3E4A"
                             FontSize="14"
                             Margin="0,5"
                             Checked="RbPayment_Checked"/>

                <RadioButton x:Name="RbCash"
                             Content="   Cash Payment"
                             GroupName="PaymentMethod"
                             Foreground="#5E3E4A"
                             FontSize="14"
                             Margin="0,5"
                             Checked="RbPayment_Checked"/>

            </StackPanel>
        </Border>

        <!-- CASH PANEL -->
        <Border Grid.Row="4"
                x:Name="CashPanel"
                Visibility="Collapsed"
                Background="#F3EDEE"
                BorderBrush="#C9A3B5"
                BorderThickness="1"
                CornerRadius="12"
                Padding="15"
                Margin="40,10,40,0">

            <StackPanel>

                <TextBlock Text="Cash Given:"
                           Foreground="#7A5A68"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtCashGiven"
                         Height="32"
                         Background="#F3EDEE"
                         BorderBrush="#C9A3B5"
                         Foreground="#5E3E4A"
                         FontSize="14"
                         Padding="6"
                         TextChanged="TxtCashGiven_TextChanged"
                         />

                <TextBlock Text="Change:"
                           Foreground="#7A5A68"
                           FontWeight="SemiBold"
                           Margin="0,12,0,5"/>

                <TextBlock x:Name="TxtChange"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#5E3E4A"/>

            </StackPanel>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">

            <!-- CONFIRM -->
            <Button x:Name="BtnConfirm"
                    Content="Confirm Payment"
                    Width="160"
                    Height="42"
                    Margin="6"
                    FontWeight="Bold"
                    Foreground="#F3EDEE"
                    Background="#5E3E4A"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnConfirm_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#7A5A68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

            <!-- BACK -->
            <Button x:Name="BtnBack"
                    Content="Back"
                    Width="120"
                    Height="42"
                    Margin="6"
                    FontWeight="Bold"
                    Foreground="#5E3E4A"
                    Background="#C9A3B5"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnBack_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#E9DDE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </StackPanel>

    </Grid>
</Window>