<Window x:Class="BillingAndPayment.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      CornerRadius="24" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F2F1F0"/>
            <Setter Property="BorderBrush" Value="#8B7365"/>
            <Setter Property="Foreground" Value="#4A2D1C"/>
            <Setter Property="CaretBrush" Value="#4A2D1C"/>
            <Setter Property="SelectionBrush" Value="#8B7365"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#4A2D1C"/>
                                <Setter Property="Background" Value="#D1C7BD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#4A2D1C"/>
                                <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2F1F0" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid Margin="35,45,35,35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Payment Method" FontSize="24" FontWeight="Bold"
                           Foreground="#4A2D1C" HorizontalAlignment="Center"/>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0"
                        Width="32" Height="32" Background="Transparent" Foreground="#4A2D1C"
                        FontWeight="Bold" Click="BtnBack_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="xBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="xBorder" Property="Background" Value="#E5DFD9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="Total Amount:"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#8B7365"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       x:Name="TxtAmount"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#4A2D1C"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,25"/>

            <Border Grid.Row="3"
                    Background="#FFFFFF"
                    BorderBrush="#D1C7BD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,15"
                    Margin="40,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="#4A2D1C"/>
                </Border.Effect>

                <StackPanel>
                    <RadioButton x:Name="RbCard"
                                 Content="   Card Payment"
                                 IsChecked="True"
                                 GroupName="PaymentMethod"
                                 Foreground="#4A2D1C"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Margin="0,6"
                                 Cursor="Hand"
                                 Checked="RbPayment_Checked"/>

                    <RadioButton x:Name="RbCash"
                                 Content="   Cash Payment"
                                 GroupName="PaymentMethod"
                                 Foreground="#4A2D1C"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Margin="0,6"
                                 Cursor="Hand"
                                 Checked="RbPayment_Checked"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    x:Name="CashPanel"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#D1C7BD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,15"
                    Margin="40,15,40,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="#4A2D1C"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Cash Given:"
                               Foreground="#8B7365"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtCashGiven"
                             Height="38"
                             FontSize="15"
                             Style="{StaticResource ModernTextBoxStyle}"
                             TextChanged="TxtCashGiven_TextChanged"/>

                    <TextBlock Text="Change to return:"
                               Foreground="#8B7365"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="0,15,0,4"/>

                    <TextBlock x:Name="TxtChange"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#4A2D1C"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">

                <Button x:Name="BtnConfirm"
                        Content="Confirm Payment"
                        Width="180"
                        Height="42"
                        Margin="6"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#F2F1F0"
                        Background="#4A2D1C"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnConfirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#5F3B26"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnBack"
                        Content="Back"
                        Width="120"
                        Height="42"
                        Margin="6"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#F2F1F0"
                        Background="#8B7365"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnBack_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="#4A2D1C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>