<Window x:Class="BillingAndPayment.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment"
        Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Payment Method" FontSize="22" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Grid.Row="1" Text="Total Amount:" FontWeight="SemiBold"
                   Foreground="#8B5E3C" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" x:Name="TxtAmount" FontSize="28" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,5,0,25"/>
        <Border Grid.Row="3" Background="#FFF8F0" BorderBrush="#E8D5B7"
                BorderThickness="1" CornerRadius="8" Padding="15" Margin="40,0">
            <StackPanel>
                <RadioButton x:Name="RbCard" Content="   Card Payment" IsChecked="True"
                             GroupName="PaymentMethod" Foreground="#5C3A21"
                             FontSize="14" Margin="0,5" Checked="RbPayment_Checked"/>
                <RadioButton x:Name="RbCash" Content="   Cash Payment"
                             GroupName="PaymentMethod" Foreground="#5C3A21"
                             FontSize="14" Margin="0,5" Checked="RbPayment_Checked"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="4" x:Name="CashPanel" Visibility="Collapsed"
                Background="#FFF8F0" BorderBrush="#E8D5B7"
                BorderThickness="1" CornerRadius="8" Padding="15"
                Margin="40,10,40,0">
            <StackPanel>
                <TextBlock Text="Cash Given:" Foreground="#8B5E3C"
                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCashGiven" Height="30"
                         Background="#FAF0E6" BorderBrush="#E8D5B7"
                         Foreground="#5C3A21" FontSize="14"
                         TextChanged="TxtCashGiven_TextChanged"/>
                <TextBlock Text="Change:" Foreground="#8B5E3C"
                           FontWeight="SemiBold" Margin="0,12,0,5"/>
                <TextBlock x:Name="TxtChange" FontSize="20" FontWeight="Bold"
                           Foreground="#5C3A21"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="BtnConfirm" Content="Confirm Payment" Width="140" Height="38"
                    Background="#5C3A21" Foreground="White" BorderThickness="0"
                    Margin="5" Cursor="Hand" FontWeight="Bold"
                    Click="BtnConfirm_Click"/>
            <Button x:Name="BtnBack" Content="Back" Width="100" Height="38"
                    Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                    Margin="5" Cursor="Hand" FontWeight="Bold"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>