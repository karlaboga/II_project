<Window x:Class="BillingAndPayment.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Table Management"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F3EDEE"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="#F3EDEE" CornerRadius="22" Margin="10">

        <Grid Margin="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                    Margin="0,0,0,0" Width="30" Height="30"
                    Background="#C9A3B5"
                    Foreground="#5E3E4A"
                    FontWeight="Bold" Click="BtnExit_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E9DDE5"/>
                                <Setter Property="Foreground" Value="#5E3E4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🍝Tables"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#5E3E4A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TableList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="110" Height="110"
                                        Margin="8"
                                        BorderThickness="2"
                                        CornerRadius="12"
                                        Cursor="Hand"
                                        Tag="{Binding Id}"
                                        MouseLeftButtonUp="TableCard_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F3EDEE"/>
                                            <Setter Property="BorderBrush" Value="#7A5A68"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                    <Setter Property="Background" Value="#E9DDE5"/>
                                                    <Setter Property="BorderBrush" Value="#8A6B7A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Selected">
                                                    <Setter Property="Background" Value="#C9A3B5"/>
                                                    <Setter Property="BorderBrush" Value="#5E3E4A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TableNumber, StringFormat='{}Table {0}'}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#5E3E4A"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Capacity, StringFormat='{},{0} seats'}"
                                                   FontSize="10"
                                                   Foreground="#5E3E4A"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,2"/>
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#5E3E4A"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1" x:Name="OrderPanel" IsEnabled="False" Opacity="0.4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtTableHeader"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#5E3E4A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBox x:Name="TxtSearch" Height="30"
                             Background="#F3EDEE"
                             BorderBrush="#7A5A68"
                             Foreground="#5E3E4A"
                             FontSize="13"
                             Padding="6"
                             TextChanged="TxtSearch_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#7A5A68"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E9DDE5"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#5E3E4A"/>
                                        <Setter TargetName="border" Property="Background" Value="#E9DDE5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>

                <ListBox Grid.Row="2"
                         x:Name="LstSearchResults"
                         Background="#F3EDEE"
                         BorderBrush="#7A5A68"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E9DDE5"
                                    CornerRadius="6"
                                    BorderBrush="#7A5A68"
                                    BorderThickness="1"
                                    Padding="8,4"
                                    Margin="1,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#5E3E4A"/>
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:0.00} RON'}"
                                                   FontSize="11"
                                                   Foreground="#5E3E4A"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="+ Add"
                                            Width="60"
                                            Height="24"
                                            Background="#8A6B7A"
                                            Foreground="#F3EDEE"
                                            BorderThickness="0"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            CommandParameter="{Binding}"
                                            Click="BtnAddDish_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DataGrid Grid.Row="3"
                          x:Name="DgOrder"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          MaxHeight="150"
                          Background="#F3EDEE"
                          BorderBrush="#7A5A68"
                          Foreground="#5E3E4A"
                          RowBackground="#F3EDEE"
                          AlternatingRowBackground="#E9DDE5"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Style.Setters>
                                <Setter Property="Background" Value="#3E2630"/>
                                <Setter Property="Foreground" Value="#F3EDEE"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="28"/>
                            </Style.Setters>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding PriceDisplay}" Width="80"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Width="30"
                                            Height="22"
                                            Background="#8A6B7A"
                                            Foreground="#F3EDEE"
                                            BorderThickness="0"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            CommandParameter="{Binding}"
                                            Click="BtnRemoveItem_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#7A5A68"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="4" Margin="0,8,0,8" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Subtotal: " FontWeight="Bold" Width="80" Foreground="#3E2630"/>
                        <TextBlock x:Name="TxtSubtotal" Text="0.00 RON" Width="100"
                                   Foreground="#3E2630" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Discount: " FontWeight="Bold" Width="80" Foreground="#3E2630"/>
                        <TextBlock x:Name="TxtDiscount" Text="0.00 RON" Width="100"
                                   Foreground="#3E2630" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Total: " FontWeight="Bold" Width="80" FontSize="14" Foreground="#3E2630"/>
                        <TextBlock x:Name="TxtTotal" Text="0.00 RON" Width="100" FontSize="14"
                                   Foreground="#3E2630" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>

                <UniformGrid Grid.Row="5" Rows="2" Columns="2" Margin="10,10,10,5" Width="460" HorizontalAlignment="Center">

                    <Button x:Name="BtnDiscount" Content="Add Discount" Height="40" Margin="6" Cursor="Hand" FontSize="14" FontWeight="Bold" Click="BtnDiscount_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#8A6B7A" CornerRadius="6">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#4A2F39" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#7A5A68"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnToKitchen" Content="🍳To Kitchen" Height="40" Margin="6" Cursor="Hand" FontSize="14" FontWeight="Bold" Click="BtnToKitchen_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#6AA66E" CornerRadius="6">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#F3EDEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5E3E4A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnBilling" Content="📋 Billing" Height="40" Margin="6" Cursor="Hand" FontSize="14" FontWeight="Bold" Click="BtnBilling_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#8A6B7A" CornerRadius="6">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#4A2F39" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#7A5A68"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnClose" Content="Close" Height="40" Margin="6" Cursor="Hand" FontSize="14" FontWeight="Bold" Click="BtnExit_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#C9A3B5" CornerRadius="6">
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#5E3E4A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E9DDE5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>