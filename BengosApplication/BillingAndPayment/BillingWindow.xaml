<Window x:Class="BillingAndPayment.BillingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Billing &amp; Payments"
        Height="650" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Billing &amp; Payments" FontSize="22" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        <!-- Add Dish Row -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Dish:" Foreground="#8B5E3C"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="CmbDish"
                      DisplayMemberPath="DisplayText"
                      Background="#FFF8F0" Foreground="#5C3A21"
                      BorderBrush="#E8D5B7" FontSize="13" Padding="4"
                      SelectionChanged="CmbDish_SelectionChanged"/>
            <TextBlock Grid.Column="2" Text="Qty:" Foreground="#8B5E3C"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <TextBox Grid.Column="3" x:Name="TxtQty" Text="1"
                     Background="#FFF8F0" Foreground="#5C3A21"
                     BorderBrush="#E8D5B7" FontSize="13" Padding="4"
                     TextAlignment="Center"/>
            <Button Grid.Column="4" Content="Add to Order"
                    Background="#D4A574" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    FontSize="13" FontWeight="Bold"
                    Padding="15,6" Margin="12,0,0,0"
                    Click="BtnAddDish_Click"/>
        </Grid>
        <!-- Unit Price Display -->
        <TextBlock Grid.Row="2" x:Name="TxtUnitPrice"
                   Foreground="#8B5E3C" FontStyle="Italic"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <!-- Order DataGrid -->
        <DataGrid Grid.Row="3" x:Name="DgOrder" AutoGenerateColumns="False"
                  Background="#FFF8F0" BorderBrush="#E8D5B7"
                  Foreground="#5C3A21" RowBackground="#FFF8F0"
                  AlternatingRowBackground="#FAF0E6"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CellEditEnding="DgOrder_CellEditEnding">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="35"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#D4A574"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding PriceDisplay}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" IsReadOnly="True" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Totals -->
        <StackPanel Grid.Row="4" Margin="0,10,10,10" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3">
                <TextBlock Text="Subtotal: " FontWeight="Bold" Width="100" Foreground="#8B5E3C"/>
                <TextBlock x:Name="TxtSubtotal" Text="0.00" Width="100" Foreground="#5C3A21" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3">
                <TextBlock Text="Discount: " FontWeight="Bold" Width="100" Foreground="#8B5E3C"/>
                <TextBlock x:Name="TxtDiscount" Text="0.00" Width="100" Foreground="#5C3A21" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3">
                <TextBlock Text="Total: " FontWeight="Bold" Width="100" FontSize="14" Foreground="#8B5E3C"/>
                <TextBlock x:Name="TxtTotal" Text="$0.00" Width="100" FontSize="14" Foreground="#5C3A21" TextAlignment="Right"/>
            </StackPanel>
        </StackPanel>
        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button x:Name="BtnEditQty" Content="Edit Order" Width="100" Height="35"
                    Background="#8B5E3C" Foreground="White" BorderThickness="0"
                    Margin="5" Cursor="Hand" FontWeight="Bold"
                    Click="BtnEditQty_Click"/>
            <Button x:Name="BtnDiscount" Content="Add Discount" Width="120" Height="35"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    Margin="5" Cursor="Hand" FontWeight="Bold"
                    Click="BtnDiscount_Click"/>
            <Button x:Name="BtnPay" Content="Pay Now" Width="100" Height="35"
                    Background="#5C3A21" Foreground="White" BorderThickness="0"
                    Margin="5" Cursor="Hand" FontWeight="Bold"
                    Click="BtnPay_Click"/>
            <Button x:Name="BtnClose" Content="Close" Width="100" Height="35"
                    Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                    Margin="5" Cursor="Hand" FontWeight="Bold"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>