<Window x:Class="BillingAndPayment.RevenueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Revenue Report"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F3EDEE"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="#F3EDEE" CornerRadius="22" Margin="10">
        <Grid Margin="45,30,45,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-20,-25,0" Width="30" Height="30"
                    Background="#C9A3B5" Foreground="#5E3E4A"
                    FontWeight="Bold" Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5E3E4A"/>
                                <Setter Property="Foreground" Value="#F3EDEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="📊 Revenue Report"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#5E3E4A"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,12"/>

            <!-- Date Range -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                <DatePicker x:Name="FromDatePicker" SelectedDate="{Binding FromDate}"
                            Background="#F3EDEE" BorderBrush="#C9A3B5"
                            Foreground="#5E3E4A" FontSize="13"/>
                <TextBlock Text="  →  " FontSize="18" FontWeight="Bold"
                           Foreground="#5E3E4A" VerticalAlignment="Center"/>
                <DatePicker x:Name="ToDatePicker" SelectedDate="{Binding ToDate}"
                            Background="#F3EDEE" BorderBrush="#C9A3B5"
                            Foreground="#5E3E4A" FontSize="13"/>
                <Button Content="Load" Width="80" Height="30" Margin="12,0,0,0"
                        Background="#5E3E4A" Foreground="#F3EDEE"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                        Click="BtnLoad_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7A5A68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Tabs -->
            <TabControl Grid.Row="2" Background="#F3EDEE" BorderBrush="#C9A3B5"
                        BorderThickness="1" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#E9DDE5"/>
                        <Setter Property="Foreground" Value="#5E3E4A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="border" Background="{TemplateBinding Background}"
                                            BorderThickness="0" Padding="{TemplateBinding Padding}"
                                            Cursor="Hand" Margin="0,0,1,0">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F3EDEE"/>
                                            <Setter Property="Foreground" Value="#5E3E4A"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#C9A3B5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Orders -->
                <TabItem Header="Orders">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" x:Name="DgOrders"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#F3EDEE" BorderBrush="#C9A3B5"
                                  Foreground="#4B2F3A" RowBackground="#F3EDEE"
                                  AlternatingRowBackground="#E9DDE5"
                                  GridLinesVisibility="Horizontal"
                                  Margin="0,0,0,8">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#5E3E4A"/>
                                    <Setter Property="Foreground" Value="#F3EDEE"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="32"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Order #" Binding="{Binding OrderId}" Width="70"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70"/>
                                <DataGridTextColumn Header="Table" Binding="{Binding TableDisplay}" Width="90"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="90"/>
                                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Background="#F3EDEE" BorderBrush="#C9A3B5"
                                BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Orders" FontSize="11" Foreground="#7A5A68" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtOrderCount" Text="0" FontSize="17"
                                               FontWeight="Bold" Foreground="#5E3E4A" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Avg Discount" FontSize="11" Foreground="#7A5A68" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAvgDiscount" Text="0%" FontSize="17"
                                               FontWeight="Bold" Foreground="#5E3E4A" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Total Revenue" FontSize="11" Foreground="#7A5A68" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTotalRevenue" Text="0.00 RON" FontSize="17"
                                               FontWeight="Bold" Foreground="#5E3E4A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Categories -->
                <TabItem Header="Categories">
                    <Grid Margin="10">
                        <lvc:PieChart x:Name="PieCategories"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Width="500" Height="400"/>
                    </Grid>
                </TabItem>

                <!-- TAB 3: Daily Trend -->
                <TabItem Header="Daily Trend">
                    <Grid Margin="10">
                        <lvc:CartesianChart x:Name="ChartDailyTrend"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                    </Grid>
                </TabItem>

                <!-- TAB 4: Top Dishes -->
                <TabItem Header="Top Dishes">
                    <Grid Margin="10">
                        <DataGrid x:Name="DgTopDishes"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#F3EDEE" BorderBrush="#C9A3B5"
                                  Foreground="#4B2F3A" RowBackground="#F3EDEE"
                                  AlternatingRowBackground="#E9DDE5"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#5E3E4A"/>
                                    <Setter Property="Foreground" Value="#F3EDEE"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="32"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dish Name" Binding="{Binding DishName}" Width="*"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Revenue" Binding="{Binding RevenueDisplay}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 5: Seating vs Takeaway -->
                <TabItem Header="Seating vs Takeaway">
                    <Grid Margin="10">
                        <lvc:PieChart x:Name="PieType"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Width="450" Height="380"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>