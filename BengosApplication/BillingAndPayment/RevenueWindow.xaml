<Window x:Class="BillingAndPayment.RevenueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Revenue Report"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAF0E6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="💰 Daily Revenue Report" FontSize="22" FontWeight="Bold"
                   Foreground="#5C3A21" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        <!-- Date picker -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <DatePicker x:Name="DatePicker" SelectedDate="{Binding SelectedDate}"
                        Background="#FFF8F0" BorderBrush="#E8D5B7"
                        Foreground="#5C3A21" FontSize="13"/>
            <Button Content="Load" Width="80" Height="30" Margin="10,0,0,0"
                    Background="#D4A574" Foreground="White" BorderThickness="0"
                    Cursor="Hand" FontWeight="Bold" Click="BtnLoad_Click"/>
        </StackPanel>
        <!-- Orders table -->
        <DataGrid Grid.Row="2" x:Name="DgOrders" AutoGenerateColumns="False"
                  IsReadOnly="True" Background="#FFF8F0" BorderBrush="#E8D5B7"
                  Foreground="#5C3A21" RowBackground="#FFF8F0"
                  AlternatingRowBackground="#FAF0E6"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5C3A21"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="32"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order #" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                <DataGridTextColumn Header="Table" Binding="{Binding TableDisplay}" Width="80"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="100"/>
                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountDisplay}" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Summary -->
        <Border Grid.Row="3" Background="#FFF8F0" BorderBrush="#E8D5B7"
                BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Orders" FontSize="11" Foreground="#8B5E3C" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtOrderCount" Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="#5C3A21" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Avg Discount" FontSize="11" Foreground="#8B5E3C" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtAvgDiscount" Text="0%" FontSize="18" FontWeight="Bold"
                               Foreground="#5C3A21" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Total Revenue" FontSize="11" Foreground="#8B5E3C" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalRevenue" Text="$0.00" FontSize="18" FontWeight="Bold"
                               Foreground="#5C3A21" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Button Grid.Row="4" Content="Close" Width="100" Height="34"
                Background="#E8D5B7" Foreground="#5C3A21" BorderThickness="0"
                FontWeight="Bold" Cursor="Hand" Margin="0,10,0,0"
                HorizontalAlignment="Center" Click="BtnClose_Click"/>
    </Grid>
</Window>
