<Window x:Class="BillingAndPayment.RevenueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Revenue Report"
        Height="650" Width="1000"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent" 
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" 
                      CornerRadius="24" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A2D1C"/>
            <Setter Property="Foreground" Value="#F2F1F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5F3B26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2F1F0" CornerRadius="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#4A2D1C"/>
        </Border.Effect>

        <Grid Margin="25,30,25,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5,5,15,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Top">
                    <TextBlock Text="Revenue Report" FontSize="22" FontWeight="Bold" Foreground="#4A2D1C" Margin="5,0,0,2"/>
                    <TextBlock Text="Financial analysis ledger" FontSize="11" Foreground="#8B7365" Margin="6,0,0,25" Opacity="0.8"/>

                    <TextBlock Text="Select Report Date" Foreground="#8B7365" FontWeight="SemiBold" Margin="5,0,5,5" FontSize="12"/>
                    <DatePicker x:Name="DatePicker" SelectedDate="{Binding SelectedDate}" Height="34" VerticalContentAlignment="Center" BorderBrush="#E5DFD9" Margin="5,0,5,12"/>
                    <Button Content="Load Analytics" Style="{StaticResource RoundedButtonStyle}" Height="36" Margin="5,0,5,0" Click="BtnLoad_Click"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5DFD9" BorderThickness="1" CornerRadius="16" Padding="20,15" Margin="5,25,5,5" VerticalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.02" Color="#4A2D1C"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PERFORMANCE METRICS" FontSize="11" FontWeight="Bold" Foreground="#8B7365" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,5">
                            <TextBlock Text="Total Orders Checked" FontSize="12" Foreground="#8B7365"/>
                            <TextBlock x:Name="TxtOrderCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4A2D1C" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,5">
                            <TextBlock Text="Average Discount Rate" FontSize="12" Foreground="#8B7365"/>
                            <TextBlock x:Name="TxtAvgDiscount" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#4A2D1C" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,5">
                            <TextBlock Text="Total Revenue" FontSize="12" Foreground="#8B7365" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTotalRevenue" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#4A2D1C" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="15,5,5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="5,0,5,15">
                    <TextBlock Text="Incoming Orders Log" FontSize="14" FontWeight="Bold" Foreground="#4A2D1C" VerticalAlignment="Center"/>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Width="32" Height="32" Background="Transparent" Foreground="#4A2D1C" 
                            FontWeight="Normal" FontSize="13" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                                    <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E5DFD9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5DFD9" BorderThickness="1" CornerRadius="16" Padding="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.02" Color="#4A2D1C"/>
                    </Border.Effect>

                    <DataGrid x:Name="DgOrders"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#4A2D1C"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F2F1F0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5DFD9"
                              RowHeight="40">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#4A2D1C"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F2F1F0"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#8B7365"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#8B7365"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#4A2D1C"/>
                                <Setter Property="Foreground" Value="#F2F1F0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order #" Binding="{Binding OrderId}" Width="90"/>
                            <DataGridTextColumn Header="Time Stamp" Binding="{Binding Time}" Width="100"/>
                            <DataGridTextColumn Header="Table" Binding="{Binding TableDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="*"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Total Settled" Binding="{Binding TotalDisplay}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>