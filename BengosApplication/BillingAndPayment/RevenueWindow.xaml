<Window x:Class="BillingAndPayment.RevenueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Revenue Report"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E5DFD9"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border CornerRadius="22" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E5DFD9" Offset="0"/>
                <GradientStop Color="#F2F1F0" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="35,25,35,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-15,-25,0" Width="30" Height="30"
                    Background="#905327" Foreground="#FFFFFF"
                    FontWeight="Bold" Click="BtnClose_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4A2D1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Row="0" Margin="0,5,0,10">
                <TextBlock Text="📊 Revenue Report"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#4A2D1C"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <DatePicker x:Name="FromDatePicker"
                                Background="#FFFFFF" BorderBrush="#DED1C4"
                                Foreground="#4A2D1C" FontSize="12"/>
                    <TextBlock Text="  →  " FontSize="18" FontWeight="Bold"
                               Foreground="#4A2D1C" VerticalAlignment="Center"/>
                    <DatePicker x:Name="ToDatePicker"
                                Background="#FFFFFF" BorderBrush="#DED1C4"
                                Foreground="#4A2D1C" FontSize="12"/>
                    <Button Content="Load" Width="80" Height="30" Margin="12,0,0,0"
                            Background="#905327" Foreground="#FFFFFF"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                            Click="BtnLoad_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4A2D1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ORDERS -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="#FFFFFF" BorderBrush="Transparent"
                        BorderThickness="0" CornerRadius="14" Margin="5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#4A2D1C"/>
                    </Border.Effect>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Orders" FontSize="15" FontWeight="Bold"
                                   Foreground="#4A2D1C" HorizontalAlignment="Center"/>
                        <Rectangle Grid.Row="1" Height="2" Width="50" Fill="#905327"
                                   HorizontalAlignment="Center" Margin="0,3,0,8" RadiusX="1" RadiusY="1"/>

                        <DataGrid Grid.Row="2" x:Name="DgOrders"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderBrush="#E5DFD9"
                                  Foreground="#4A2D1C" RowBackground="Transparent"
                                  AlternatingRowBackground="#F2F1F0"
                                  GridLinesVisibility="Horizontal"
                                  Margin="0,0,0,6">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A2D1C"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="30"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding OrderId}" Width="45"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="55"/>
                                <DataGridTextColumn Header="Table" Binding="{Binding TableDisplay}" Width="65"/>
                                <DataGridTextColumn Header="Sub" Binding="{Binding Subtotal}" Width="60"/>
                                <DataGridTextColumn Header="Disc" Binding="{Binding DiscountDisplay}" Width="75"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="3" Background="#F2F1F0" BorderBrush="#E5DFD9"
                                BorderThickness="1" CornerRadius="10" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Orders" FontSize="10" Foreground="#905327" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtOrderCount" Text="0" FontSize="14"
                                               FontWeight="Bold" Foreground="#4A2D1C" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Avg Disc" FontSize="10" Foreground="#905327" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAvgDiscount" Text="0%" FontSize="14"
                                               FontWeight="Bold" Foreground="#4A2D1C" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Revenue" FontSize="10" Foreground="#905327" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTotalRevenue" Text="0.00 RON" FontSize="14"
                                               FontWeight="Bold" Foreground="#4A2D1C" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- CATEGORIES -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="#FFFFFF" BorderBrush="Transparent"
                        BorderThickness="0" CornerRadius="14" Margin="5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#4A2D1C"/>
                    </Border.Effect>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Categories" FontSize="15" FontWeight="Bold"
                                   Foreground="#4A2D1C" HorizontalAlignment="Center"/>
                        <Rectangle Grid.Row="1" Height="2" Width="50" Fill="#905327"
                                   HorizontalAlignment="Center" Margin="0,3,0,8" RadiusX="1" RadiusY="1"/>
                        <lvc:PieChart x:Name="PieCategories" Grid.Row="2"/>
                    </Grid>
                </Border>

                <!-- DAILY TREND -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="#FFFFFF" BorderBrush="Transparent"
                        BorderThickness="0" CornerRadius="14" Margin="5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#4A2D1C"/>
                    </Border.Effect>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Daily Trend" FontSize="15" FontWeight="Bold"
                                   Foreground="#4A2D1C" HorizontalAlignment="Center"/>
                        <Rectangle Grid.Row="1" Height="2" Width="50" Fill="#905327"
                                   HorizontalAlignment="Center" Margin="0,3,0,8" RadiusX="1" RadiusY="1"/>
                        <lvc:CartesianChart x:Name="ChartDailyTrend" Grid.Row="2"/>
                    </Grid>
                </Border>

                <!-- TOP DISHES -->
                <Border Grid.Row="1" Grid.Column="1"
                        Background="#FFFFFF" BorderBrush="Transparent"
                        BorderThickness="0" CornerRadius="14" Margin="5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#4A2D1C"/>
                    </Border.Effect>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top Dishes" FontSize="15" FontWeight="Bold"
                                   Foreground="#4A2D1C" HorizontalAlignment="Center"/>
                        <Rectangle Grid.Row="1" Height="2" Width="50" Fill="#905327"
                                   HorizontalAlignment="Center" Margin="0,3,0,8" RadiusX="1" RadiusY="1"/>
                        <DataGrid x:Name="DgTopDishes"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderBrush="#E5DFD9"
                                  Foreground="#4A2D1C" RowBackground="Transparent"
                                  AlternatingRowBackground="#F2F1F0"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4A2D1C"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="30"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dish Name" Binding="{Binding DishName}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                                <DataGridTextColumn Header="Revenue" Binding="{Binding RevenueDisplay}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>