<Window x:Class="BillingAndPayment.RevenueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Revenue Report"
        Height="650" Width="1000"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
WindowStyle="None"
AllowsTransparency="True"
Background="#F3EDEE"
FontFamily="Segoe UI"
TextOptions.TextFormattingMode="Display"
TextOptions.TextRenderingMode="ClearType">

    <Border Background="#F3EDEE" CornerRadius="22" Margin="10">

        

        <Grid Margin="55">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <TextBlock Grid.Row="0"
                   Text="💰 Daily Revenue Report"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#5E3E4A"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

            <!-- DATE PICKER -->
            <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">

                <DatePicker x:Name="DatePicker"
                        SelectedDate="{Binding SelectedDate}"
                        Background="#F3EDEE"
                        BorderBrush="#C9A3B5"
                        Foreground="#5E3E4A"
                        FontSize="13"/>

                <Button Content="Load"
                    Width="80"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="#5E3E4A"
                    Foreground="#F3EDEE"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    Click="BtnLoad_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7A5A68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </StackPanel>

            <!-- DATA GRID -->
            <DataGrid Grid.Row="2"
                  x:Name="DgOrders"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#F3EDEE"
                  BorderBrush="#C9A3B5"
                  Foreground="#4B2F3A"
                  RowBackground="#F3EDEE"
                  AlternatingRowBackground="#E9DDE5"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

                <DataGrid.Resources>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#5E3E4A"/>
                        <Setter Property="Foreground" Value="#F3EDEE"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="32"/>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order #" Binding="{Binding OrderId}" Width="80"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                    <DataGridTextColumn Header="Table" Binding="{Binding TableDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="100"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="100"/>
                </DataGrid.Columns>

            </DataGrid>

            <!-- SUMMARY -->
            <Border Grid.Row="3"
                Background="#F3EDEE"
                BorderBrush="#C9A3B5"
                BorderThickness="1"
                CornerRadius="12"
                Padding="15"
                Margin="0,10,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Orders"
                               FontSize="11"
                               Foreground="#7A5A68"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtOrderCount"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#5E3E4A"
                               HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Avg Discount"
                               FontSize="11"
                               Foreground="#7A5A68"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtAvgDiscount"
                               Text="0%"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#5E3E4A"
                               HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Total Revenue"
                               FontSize="11"
                               Foreground="#7A5A68"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalRevenue"
                               Text="$0.00"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#5E3E4A"
                               HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- CLOSE -->
            <Button Grid.Row="4"
                Content="Close"
                Width="120"
                Height="34"
                Background="#5E3E4A"
                Foreground="#F3EDEE"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Click="BtnClose_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7A5A68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>
    </Border>
</Window>