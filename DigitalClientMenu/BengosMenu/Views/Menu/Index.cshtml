@model System.Collections.Generic.List<string>
@{
    ViewBag.Title = "Bengos Menu";
}
<!DOCTYPE html>
<html>
<head>
    <title>Bengos - Fine Dining</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial;
            margin: 0;
            padding: 0;
            background: #F8F8F8;
            color: #3D3B3A;
        }

        .header {
            background: #3E3C3B;
            color: #FFFFFF;
            padding: 40px;
            text-align: center;
        }

        .description {
            max-width: 800px;
            margin: 20px auto;
            font-size: 1.1em;
            line-height: 1.6;
            color: #E2E2E1;
        }

        .qr-section {
            margin: 30px auto;
            text-align: center;
            background: #EEEDED;
            padding: 20px;
            border-radius: 8px;
            display: inline-block;
        }

        .qr-code {
            max-height: 150px;
            background: #FFFFFF;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #CCCBCB;
        }

        .qr-text {
            color: #464443;
            margin-top: 10px;
            font-size: 0.9em;
        }

        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        h1 {
            text-align: center;
            color: #3D3B3A;
        }

        .categories {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .category-card {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 30px;
            width: 250px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(204,203,203,0.3);
            transition: transform 0.3s;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            border: 1px solid #E2E2E1;
        }

            .category-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 6px 12px rgba(61,59,58,0.15);
            }

        .category-icon {
            font-size: 3em;
            margin-bottom: 15px;
        }

        .category-name {
            font-size: 1.5em;
            color: #3D3B3A;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1 style="margin: 10px 0; color: #FFFFFF;">Welcome to Bengos</h1>
        <div class="description">
            Experience the art of fine dining at Bengos, where culinary excellence meets warm hospitality.
            Our chefs craft each dish with passion, using only the freshest ingredients sourced locally.
            From sizzling main courses to decadent desserts and handcrafted drinks, every bite tells a story.
        </div>
        <div class="qr-section">
            <img src="@Url.Action("GenerateQRCode")" alt="Scan to open menu" class="qr-code" />
            <p class="qr-text">Scan to open menu on your phone</p>
        </div>
    </div>
    <div class="container">
        <h1>Our Menu</h1>
        <div class="categories">
            @foreach (var category in Model)
            {
                <a href="@Url.Action("Category", new { category = category })" class="category-card">
                    <div class="category-icon">
                        @if (category == "Main Course")
                        {<text>🍽️</text> }
                    else if (category == "Dessert")
                    { <text>🍰</text> }
                else if (category == "Drinks")
                { <text>🍹</text>}
                    </div>
                    <div class="category-name">@category</div>
                </a>
            }
        </div>
    </div>
</body>
</html>