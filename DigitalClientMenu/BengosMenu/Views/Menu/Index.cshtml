@model System.Collections.Generic.List<string>
@{
    ViewBag.Title = "Bengos Menu";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bengos Restaurant - Menu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #F8F8F8;
            font-family: 'Jost', sans-serif;
            color: #3D3B3A;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Hero */
        .hero {
            background: #3E3C3B;
            border-radius: 20px;
            padding: 40px 24px;
            margin-bottom: 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: -60px; right: -60px;
            width: 200px; height: 200px;
            border-radius: 50%;
            border: 1px solid rgba(204,203,203,0.2);
        }
        .hero::after {
            content: '';
            position: absolute;
            bottom: -40px; left: -40px;
            width: 140px; height: 140px;
            border-radius: 50%;
            border: 1px solid rgba(204,203,203,0.12);
        }
        .hero-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 38px;
            font-weight: 300;
            color: #FFFFFF;
            line-height: 1.1;
            margin-bottom: 8px;
        }
        .hero-title em { font-style: italic; color: #E2E2E1; }
        .hero-sub {
            font-size: 12px;
            color: rgba(255,255,255,0.45);
            letter-spacing: 0.5px;
            margin-bottom: 22px;
        }
        .hero-actions { display: flex; gap: 10px; justify-content: center; }
        .btn-primary {
            background: #CCCBCB;
            color: #3D3B3A;
            border: none;
            padding: 11px 22px;
            border-radius: 30px;
            font-family: 'Jost', sans-serif;
            font-size: 11px;
            font-weight: 500;
            cursor: pointer;
        }
        .btn-ghost {
            background: transparent;
            color: rgba(255,255,255,0.7);
            border: 0.5px solid rgba(255,255,255,0.22);
            padding: 11px 18px;
            border-radius: 30px;
            font-family: 'Jost', sans-serif;
            font-size: 11px;
            cursor: pointer;
        }

        /* Section label */
        .section-label {
            font-size: 10px;
            letter-spacing: 2.5px;
            color: #464443;
            text-transform: uppercase;
            margin-bottom: 14px;
            font-weight: 400;
        }

        /* Category pills */
        .category-row {
            display: flex;
            gap: 8px;
            margin-bottom: 22px;
            overflow-x: auto;
            padding-bottom: 4px;
        }
        .cat-pill {
            background: #FFFFFF;
            border: 0.5px solid rgba(61,59,58,0.1);
            border-radius: 30px;
            padding: 7px 16px;
            font-size: 12px;
            white-space: nowrap;
            cursor: pointer;
            color: #3D3B3A;
            font-weight: 400;
        }
        .cat-pill.active {
            background: #3E3C3B;
            color: #FFFFFF;
            border-color: #3E3C3B;
        }

        /* Dish grid */
        .dish-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .dish-card {
            background: #FFFFFF;
            border: 0.5px solid #E2E2E1;
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
        }
        .dish-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(61,59,58,0.15);
        }
        .dish-img {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 64px;
            background: #F8F8F8;
        }
        .dish-info { padding: 20px; }
        .dish-name {
            font-size: 18px;
            font-weight: 500;
            color: #3D3B3A;
            margin-bottom: 8px;
        }
        .dish-desc {
            font-size: 13px;
            color: #464443;
            line-height: 1.5;
            margin-bottom: 12px;
        }
        .dish-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .dish-price {
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px;
            font-weight: 600;
            color: #3E3C3B;
        }
        .add-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #3D3B3A;
            border: none;
            color: #FFFFFF;
            font-size: 24px;
            line-height: 1;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .add-btn:hover { background: #464443; }
    </style>
</head>
<body>
    <div class="container">
        <!-- Hero -->
        <div class="hero">
            <div class="hero-title">Bengos <em>Restaurant</em></div>
            <div class="hero-sub">Fine dining · Est. 2024</div>
            <div class="hero-actions">
                <button class="btn-primary">View Menu</button>
                <button class="btn-ghost">Reserve</button>
            </div>
        </div>

        <!-- Browse -->
        <div class="section-label">Browse Categories</div>
        <div class="category-row">
            <div class="cat-pill active">All</div>
            <div class="cat-pill">Food</div>
            <div class="cat-pill">Drinks</div>
            <div class="cat-pill">Desserts</div>
        </div>

        <!-- Dish grid -->
        <div class="dish-grid">
            @foreach (var category in Model)
            {
                <div class="dish-card">
                    <div class="dish-img">
                        @if (category == "Main Course") { <text>🍽️</text> }
                        else if (category == "Dessert") { <text>🍰</text> }
                        else if (category == "Drinks") { <text>🍹</text> }
                        else { <text>🍽️</text> }
                    </div>
                    <div class="dish-info">
                        <div class="dish-name">@category</div>
                        <div class="dish-desc">Fresh ingredients, crafted with passion</div>
                        <div class="dish-footer">
                            <span class="dish-price">$0.00</span>
                            <button class="add-btn">+</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</body>
</html>
