@{
    ViewData["Title"] = "Menu - Bengos Restaurant";
}

<style>
    .category-card {
        background-color: #FFFFFF;
        border: 1px solid #CCCBCB;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 20px;
        transition: transform 0.3s, box-shadow 0.3s;
        cursor: pointer;
    }
    .category-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .category-title {
        color: #3D3B3A;
        font-size: 1.5rem;
        margin-bottom: 10px;
    }
</style>

<div class="row" style="padding: 50px 0;">
    <div class="col-12">
        <h1 style="color: #3D3B3A; margin-bottom: 40px;">Our Menu Categories</h1>
    </div>
</div>

<div class="row">
    @foreach (var category in Model)
    {
        <div class="col-md-4 mb-4">
            <a asp-controller="Menu" asp-action="Category" asp-route-category="@category" 
               style="text-decoration: none;">
                <div class="category-card">
                    <h3 class="category-title">@category</h3>
                    <p style="color: #3E3C3B;">Click to view dishes</p>
                </div>
            </a>
        </div>
    }
</div>
