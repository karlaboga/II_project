@{
    ViewData["Title"] = "Home - Bengos Restaurant";
}

<div class="text-center" style="padding: 50px 0;">
    <h1 class="display-4" style="color: #3D3B3A;">Welcome to Bengos Restaurant</h1>
    <p class="lead" style="color: #3E3C3B;">Experience the finest dining with our carefully crafted menu.</p>
    <div class="mt-5">
        <a asp-controller="Menu" asp-action="Index" class="btn btn-lg" style="background-color: #3D3B3A; color: #FFFFFF; padding: 15px 40px; border-radius: 30px; text-decoration: none;">
            View Our Menu
        </a>
    </div>
</div>

<div class="row mt-5" style="margin-top: 80px !important;">
    <div class="col-md-4 mb-4">
        <div class="card" style="background-color: #FFFFFF; border: 1px solid #CCCBCB; border-radius: 15px;">
            <div class="card-body text-center" style="padding: 30px;">
                <h3 style="color: #3D3B3A;">🍽️ Quality Food</h3>
                <p style="color: #3E3C3B;">Fresh ingredients, expertly prepared</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card" style="background-color: #FFFFFF; border: 1px solid #CCCBCB; border-radius: 15px;">
            <div class="card-body text-center" style="padding: 30px;">
                <h3 style="color: #3D3B3A;">⏰ Quick Service</h3>
                <p style="color: #3E3C3B;">Fast and friendly service</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card" style="background-color: #FFFFFF; border: 1px solid #CCCBCB; border-radius: 15px;">
            <div class="card-body text-center" style="padding: 30px;">
                <h3 style="color: #3D3B3A;">💯 Best Prices</h3>
                <p style="color: #3E3C3B;">Great value for your money</p>
            </div>
        </div>
    </div>
</div>
