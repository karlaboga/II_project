@{
    ViewBag.Title = "Bengos Restaurant - Home";
}

<main style="background-color: #F8F8F8; padding: 20px;">
    <section class="row" aria-labelledby="bengosTitle" style="text-align: center; padding: 40px; background-color: #3E3C3B; color: #FFFFFF; border-radius: 8px; margin-bottom: 30px;">
        <h1 id="title" style="color: #FFFFFF;">Welcome to Bengos Restaurant</h1>
        <p class="lead" style="color: #E2E2E1; font-size: 1.2em;">Experience the art of fine dining where culinary excellence meets warm hospitality.</p>
        <p><a href="@Url.Action("Index", "Menu")" class="btn" style="background-color: #FFFFFF; color: #3D3B3A; padding: 10px 30px; text-decoration: none; border-radius: 4px; font-weight: bold;">View Our Menu &raquo;</a></p>
    </section>

    <div class="row" style="display: flex; gap: 20px; justify-content: center;">
        <section class="col-md-4" aria-labelledby="freshTitle" style="background-color: #FFFFFF; padding: 30px; border-radius: 8px; box-shadow: 0 2px 4px rgba(204,203,203,0.3);">
            <h2 id="freshTitle" style="color: #3D3B3A;">Fresh Ingredients</h2>
            <p style="color: #464443; line-height: 1.6;">
                Our chefs craft each dish with passion, using only the freshest ingredients sourced locally.
            </p>
        </section>
        <section class="col-md-4" aria-labelledby="menuTitle" style="background-color: #FFFFFF; padding: 30px; border-radius: 8px; box-shadow: 0 2px 4px rgba(204,203,203,0.3);">
            <h2 id="menuTitle" style="color: #3D3B3A;">Diverse Menu</h2>
            <p style="color: #464443; line-height: 1.6;">From sizzling main courses to decadent desserts and handcrafted drinks, every bite tells a story.</p>
        </section>
        <section class="col-md-4" aria-labelledby="serviceTitle" style="background-color: #FFFFFF; padding: 30px; border-radius: 8px; box-shadow: 0 2px 4px rgba(204,203,203,0.3);">
            <h2 id="serviceTitle" style="color: #3D3B3A;">Exceptional Service</h2>
            <p style="color: #464443; line-height: 1.6;">Warm hospitality in an elegant atmosphere that makes every visit memorable.</p>
        </section>
    </div>
</main>