<Window x:Class="inventoryWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory" Height="500" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ID_prod" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="textBox_IDprod" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="1" Text="Product" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="textBox_Product" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="2" Text="Category" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="comboBox_Category" Grid.Row="2" Grid.Column="1" Margin="5" SelectionChanged="FilterControl_SelectionChanged">
            <ComboBoxItem Content="All"/>
            <ComboBoxItem Content="Fruits"/>
            <ComboBoxItem Content="Vegetables"/>
            <ComboBoxItem Content="Meat"/>
            <ComboBoxItem Content="Dairy"/>
            <ComboBoxItem Content="Spices"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Quantity" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="textBox_Quantity" Grid.Row="3" Grid.Column="1" Margin="5" Text="0"/>

        <TextBlock Grid.Row="4" Text="Unit" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="comboBox_Unit" Grid.Row="4" Grid.Column="1" Margin="5" SelectionChanged="comboBox_Unit_SelectionChanged">
            <ComboBoxItem Content="Kilograms"/>
            <ComboBoxItem Content="Liters"/>
            <ComboBoxItem Content="Pieces"/>
            <ComboBoxItem Content="Boxes"/>
        </ComboBox>

        <TextBlock Grid.Row="5" Text="Min_Stock" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="textBox_MinStock" Grid.Row="5" Grid.Column="1" Margin="5" Text="0"/>

        <!-- Buttons -->
        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="6" VerticalAlignment="Center">
            <Button x:Name="button_Add" Content="Add" Background="LightGreen" Margin="10" Padding="10" Click="button_Add_Click"/>
            <Button x:Name="button_Edit" Content="Edit" Background="LightBlue" Margin="10" Padding="10" Click="button_Edit_Click"/>
            <Button x:Name="button_Delete" Content="Delete" Background="LightCoral" Margin="10" Padding="10" Click="button_Delete_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="dataGrid1" Grid.Row="6" Grid.ColumnSpan="3" Margin="5" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="dataGrid1_SelectionChanged"/>
    </Grid>
</Window>