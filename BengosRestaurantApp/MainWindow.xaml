<Window x:Class="BengosRestaurantApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bengos Restaurant - Main Menu"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F8F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Image Grid.Row="0" Source="Bengos_Logo.png" Height="100" Margin="0,20,0,10" Stretch="Uniform"/>

        <!-- Title -->
        <TextBlock Grid.Row="1" Text="Bengos Restaurant" FontSize="28" FontWeight="Bold"
                   Foreground="#3D3B3A" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <Button x:Name="BtnInventory" Content="📦 Inventory Management"
                    Height="60" FontSize="16" FontWeight="Bold"
                    Background="#3E3C3B" Foreground="#FFFFFF" BorderThickness="0"
                    Margin="0,5" Click="BtnInventory_Click"/>
            <Button x:Name="BtnStaff" Content="👥 Staff Management"
                    Height="60" FontSize="16" FontWeight="Bold"
                    Background="#464443" Foreground="#FFFFFF" BorderThickness="0"
                    Margin="0,5" Click="BtnStaff_Click"/>
            <Button x:Name="BtnBilling" Content="💳 Billing &amp; Payments"
                    Height="60" FontSize="16" FontWeight="Bold"
                    Background="#3D3B3A" Foreground="#FFFFFF" BorderThickness="0"
                    Margin="0,5" Click="BtnBilling_Click"/>
            <Button x:Name="BtnMenu" Content="🍽️ Digital Client Menu"
                    Height="60" FontSize="16" FontWeight="Bold"
                    Background="#3E3C3B" Foreground="#FFFFFF" BorderThickness="0"
                    Margin="0,5" Click="BtnMenu_Click"/>
            <Button x:Name="BtnExit" Content="Exit"
                    Height="60" FontSize="16" FontWeight="Bold"
                    Background="#CCCBCB" Foreground="#3D3B3A" BorderThickness="0"
                    Margin="0,5" Click="BtnExit_Click"/>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="Bengos Restaurant Management System"
                   FontSize="10" Foreground="#464443" HorizontalAlignment="Center" Margin="0,10"/>
    </Grid>
</Window>
