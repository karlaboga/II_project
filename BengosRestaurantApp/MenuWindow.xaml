<Window x:Class="BengosRestaurantApp.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Client Menu"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FBEAF0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Bengos Restaurant Menu" FontSize="24" FontWeight="Bold"
                   Foreground="#993556" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Category Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <RadioButton x:Name="RbAll" Content="All" IsChecked="True" Margin="5" GroupName="Category"
                         Checked="CategoryFilter_Changed"/>
            <RadioButton x:Name="RbFood" Content="Food" Margin="5" GroupName="Category"
                         Checked="CategoryFilter_Changed"/>
            <RadioButton x:Name="RbDrinks" Content="Drinks" Margin="5" GroupName="Category"
                         Checked="CategoryFilter_Changed"/>
            <RadioButton x:Name="RbDesserts" Content="Desserts" Margin="5" GroupName="Category"
                         Checked="CategoryFilter_Changed"/>
        </StackPanel>

        <!-- Menu Items -->
        <ListView x:Name="LvMenu" Grid.Row="2" Background="White">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10">
                        <Grid Width="700">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="80" Height="80" Background="LightGray" CornerRadius="5">
                                <TextBlock Text="🍽️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Ingredients}" TextWrapping="Wrap" FontSize="11" Foreground="DarkGray" Margin="0,5,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding PriceDisplay}" FontSize="18" FontWeight="Bold"
                                       Foreground="#993556" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Close Button -->
        <Button Grid.Row="3" Content="Close" Width="100" Height="35" Background="Gray" Foreground="White"
                BorderThickness="0" HorizontalAlignment="Right" Margin="0,10,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
