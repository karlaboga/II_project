<Window x:Class="BengosRestaurantApp.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Management"
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#cfc0bd">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Inventory Management" FontSize="18" FontWeight="Bold"
                   Foreground="#76938e" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Input Fields -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Product:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtProduct" Width="120" Height="25" Background="#cfc0bd" BorderBrush="#988071"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Category:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCategory" Width="120" Height="25" Background="#cfc0bd" BorderBrush="#988071">
                    <ComboBoxItem Content="Food"/>
                    <ComboBoxItem Content="Drinks"/>
                    <ComboBoxItem Content="Desserts"/>
                    <ComboBoxItem Content="Ingredients"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Quantity:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtQuantity" Width="80" Height="25" Background="#cfc0bd" BorderBrush="#988071"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Unit:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtUnit" Width="80" Height="25" Background="#cfc0bd" BorderBrush="#988071"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Min Stock:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtMinStock" Width="80" Height="25" Background="#cfc0bd" BorderBrush="#988071"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,100,0,0">
            <Button x:Name="BtnAdd" Content="Add" Width="80" Height="30"
                    Background="#76938e" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnAdd_Click"/>
            <Button x:Name="BtnEdit" Content="Edit" Width="80" Height="30"
                    Background="#7f9183" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnEdit_Click"/>
            <Button x:Name="BtnDelete" Content="Delete" Width="80" Height="30"
                    Background="#988071" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnDelete_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="DgInventory" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#b8b8aa" BorderBrush="#988071" Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                <DataGridTextColumn Header="Min Stock" Binding="{Binding Min_Stock}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Close Button -->
        <Button Grid.Row="3" Content="Close" Width="100" Height="35"
                Background="#76938e" Foreground="#cfc0bd" BorderThickness="0"
                HorizontalAlignment="Right" Click="BtnClose_Click"/>
    </Grid>
</Window>
