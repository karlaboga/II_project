<Window x:Class="BengosRestaurantApp.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Management"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#cfc0bd">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Shift Management" FontSize="20" FontWeight="Bold"
                   Foreground="#76938e" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Input Fields -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Staff Member:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbStaff" Width="120" Height="25" Background="#cfc0bd" BorderBrush="#988071">
                    <ComboBoxItem Content="waiter1"/>
                    <ComboBoxItem Content="waiter2"/>
                    <ComboBoxItem Content="chef1"/>
                    <ComboBoxItem Content="chef2"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Day:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbDay" Width="100" Height="25" Background="#cfc0bd" BorderBrush="#988071">
                    <ComboBoxItem Content="monday"/>
                    <ComboBoxItem Content="tuesday"/>
                    <ComboBoxItem Content="wednesday"/>
                    <ComboBoxItem Content="thursday"/>
                    <ComboBoxItem Content="friday"/>
                    <ComboBoxItem Content="saturday"/>
                    <ComboBoxItem Content="sunday"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Shift Type:" Foreground="#7f9183" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbShiftType" Width="100" Height="25" Background="#cfc0bd" BorderBrush="#988071">
                    <ComboBoxItem Content="morning"/>
                    <ComboBoxItem Content="evening"/>
                    <ComboBoxItem Content="night"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="5">
                <CheckBox x:Name="ChkOvertime" Content="Overtime" FontSize="12" Foreground="#7f9183" Margin="0,20,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="BtnAdd" Content="Add" Width="80" Height="30"
                    Background="#76938e" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnAdd_Click"/>
            <Button x:Name="BtnDelete" Content="Delete" Width="80" Height="30"
                    Background="#7f9183" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnDelete_Click"/>
            <Button x:Name="BtnClear" Content="Clear All" Width="100" Height="30"
                    Background="#988071" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnClear_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="DgShifts" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#b8b8aa" BorderBrush="#988071" SelectionChanged="DgShifts_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Staff" Binding="{Binding Staff}" Width="*"/>
                <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/>
                <DataGridTextColumn Header="Shift Type" Binding="{Binding ShiftType}" Width="*"/>
                <DataGridTextColumn Header="Overtime" Binding="{Binding OvertimeText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Close Button -->
        <Button Grid.Row="4" Content="Close" Width="100" Height="35"
                Background="#76938e" Foreground="#cfc0bd" BorderThickness="0"
                HorizontalAlignment="Right" Margin="0,10,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
