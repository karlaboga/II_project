<Window x:Class="BengosRestaurantApp.BillingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Billing &amp; Payments"
        Height="600" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#cfc0bd">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Billing &amp; Payments" FontSize="20" FontWeight="Bold"
                   Foreground="#76938e" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Order Grid -->
        <DataGrid x:Name="DgOrder" Grid.Row="1" AutoGenerateColumns="False"
                  Background="#b8b8aa" BorderBrush="#988071"
                  CellEditEnding="DgOrder_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding PriceDisplay}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" IsReadOnly="True" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals -->
        <StackPanel Grid.Row="2" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                <TextBlock Text="Subtotal: " FontWeight="Bold" Width="100" Foreground="#7f9183"/>
                <TextBlock x:Name="TxtSubtotal" Text="0.00" Width="100" Foreground="#76938e"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                <TextBlock Text="Discount: " FontWeight="Bold" Width="100" Foreground="#7f9183"/>
                <TextBlock x:Name="TxtDiscount" Text="0.00" Width="100" Foreground="#76938e"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                <TextBlock Text="Total: " FontWeight="Bold" Width="100" FontSize="14" Foreground="#7f9183"/>
                <TextBlock x:Name="TxtTotal" Text="$0.00" Width="100" FontSize="14" Foreground="#76938e"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnEditQty" Content="Edit Order" Width="100" Height="35"
                    Background="#988071" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnEditQty_Click"/>
            <Button x:Name="BtnDiscount" Content="Add Discount" Width="100" Height="35"
                    Background="#76938e" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnDiscount_Click"/>
            <Button x:Name="BtnPay" Content="Pay Now" Width="100" Height="35"
                    Background="#7f9183" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnPay_Click"/>
            <Button x:Name="BtnClose" Content="Close" Width="100" Height="35"
                    Background="#988071" Foreground="#cfc0bd" BorderThickness="0" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
